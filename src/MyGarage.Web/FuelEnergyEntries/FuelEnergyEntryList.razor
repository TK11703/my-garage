@* Display only: the parent loads the page of entries. *@
<EntryListBlock TItem="FuelEnergyEntryDto" Items="Entries?.Items" TotalCount="Entries?.TotalCount ?? 0" Page="Entries?.Page ?? 1" TotalPages="Entries?.TotalPages ?? 1"
                HrefFor="HrefFor" Failure="Failure" ReturnUrl="@ReturnUrl" EmptyMessage="No fuel or charging entries yet. Add the first one for this vehicle." ListTestId="fuel-energy-entry-list">
    <RowTemplate Context="entry">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2" data-testid="fuel-energy-entry">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-semibold" data-testid="entry-date">@DisplayFormat.Date(entry.EntryDate)</span>
                    <span class="badge @(entry.Kind == FuelEnergyKind.Fuel ? "text-bg-secondary" : "text-bg-success")" data-testid="entry-kind">@FuelEnergyEntryFormat.KindLabel(entry.Kind)</span>
                    @if (entry.FromEmail)
                    {
                        <span class="badge text-bg-info fw-normal" data-testid="from-email">From email</span>
                    }
                </div>
                <div class="small text-body-secondary" data-testid="entry-detail">@FuelEnergyEntryFormat.Detail(entry)</div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="fw-semibold" data-testid="entry-total">@DisplayFormat.Money(entry.TotalCost)</span>
                <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" href="/vehicles/@VehicleId/fuel-energy-entries/@entry.Id/edit"
                   data-testid="edit-entry" aria-label="@FuelEnergyEntryFormat.EditName(entry)" title="@FuelEnergyEntryFormat.EditName(entry)">
                    <Icon Name="IconName.Pencil" /> Edit
                </a>
            </div>
        </div>
    </RowTemplate>
</EntryListBlock>

@code {
    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    [Parameter]
    public PagedResultDto<FuelEnergyEntryDto>? Entries { get; set; }

    [Parameter]
    public GarageApiFailure? Failure { get; set; }

    // App-relative page to come back to after signing in again.
    [Parameter]
    public string ReturnUrl { get; set; } = "/";

    [Parameter, EditorRequired]
    public Func<int, string> HrefFor { get; set; } = _ => "#";
}
