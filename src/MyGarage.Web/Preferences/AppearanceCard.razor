<section class="card border-0 shadow-sm mb-4" aria-labelledby="appearance-heading" data-testid="appearance">
    <div class="card-body">
        <h2 id="appearance-heading" class="h5">Appearance</h2>
        <div class="mg-themes" role="group" aria-label="Color theme">
            <button type="button" class="mg-theme-tile" data-mg-theme-set="light" aria-pressed="false"><i class="mg-theme-swatch mg-theme-swatch-light" aria-hidden="true"></i>Light</button>
            <button type="button" class="mg-theme-tile" data-mg-theme-set="dark" aria-pressed="false"><i class="mg-theme-swatch mg-theme-swatch-dark" aria-hidden="true"></i>Dark</button>
        </div>
        <p class="form-text mt-2 mb-0" data-testid="appearance-note">Your choice is kept in this browser only. Until you choose, the page follows your device setting.</p>
    </div>
</section>
