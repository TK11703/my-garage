<section class="card border-0 shadow-sm mb-4" aria-labelledby="account-heading" data-testid="account-details">
    <div class="card-body">
        <h2 id="account-heading" class="h5">Account</h2>
        <dl class="row g-3 mb-2">
            <ViewField Label="Name" Value="@Show(User?.DisplayName)" Column="col-sm-6" />
            <ViewField Label="Email" Value="@Show(User?.Email)" Column="col-sm-6" />
        </dl>
        <p class="form-text mb-0">Your account details come from your sign-in and cannot be changed here.</p>
    </div>
</section>

@code {
    // Null when the details could not be loaded.
    [Parameter]
    public CurrentUserDto? User { get; set; }

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "Not available" : value;
}
