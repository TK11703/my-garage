@page "/preferences"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject GarageApiClient UserApi
@inject LookupsApiClient LookupsApi

<PageHeader Title="Preferences" Trail="@(new[] { new Crumb("Preferences") })" />

<AccountDetails User="user" />

@if (failure is not null)
{
    <ApiFailureAlert Failure="failure.Value" ReturnUrl="/preferences"
                     NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
}
else if (lookups is not null)
{
    <TabNav Tabs="PreferencesTabs.All" Current="@activeTab" IdPrefix="lookup" />

    <div class="tab-content">
        @* Each tab sits in its own form scope so its "add" form is told apart from the other tabs' (the scope must wrap the component). *@
        <FormMappingScope Name="@($"lookup-{LookupKinds.VehicleTypes}")" Context="vehicleTypesScope">
            <LookupTab Slug="@LookupKinds.VehicleTypes" Label="Vehicle Types" Items="lookups.VehicleTypes"
                       Active="@(activeTab == LookupKinds.VehicleTypes)" OnAttention="Attend" />
        </FormMappingScope>
        <FormMappingScope Name="@($"lookup-{LookupKinds.FuelTypes}")" Context="fuelTypesScope">
            <LookupTab Slug="@LookupKinds.FuelTypes" Label="Fuel Types" Items="lookups.FuelTypes"
                       Active="@(activeTab == LookupKinds.FuelTypes)" OnAttention="Attend" />
        </FormMappingScope>
        <FormMappingScope Name="@($"lookup-{LookupKinds.Transmissions}")" Context="transmissionsScope">
            <LookupTab Slug="@LookupKinds.Transmissions" Label="Transmissions" Items="lookups.Transmissions"
                       Active="@(activeTab == LookupKinds.Transmissions)" OnAttention="Attend" />
        </FormMappingScope>
        <FormMappingScope Name="@($"lookup-{LookupKinds.Drivetrains}")" Context="drivetrainsScope">
            <LookupTab Slug="@LookupKinds.Drivetrains" Label="Drivetrains" Items="lookups.Drivetrains"
                       Active="@(activeTab == LookupKinds.Drivetrains)" OnAttention="Attend" />
        </FormMappingScope>
    </div>
}

@code {
    private CurrentUserDto? user;
    private LookupsDto? lookups;
    private GarageApiFailure? failure;
    private string activeTab = PreferencesTabs.All[0].Id;

    // Which lookup tab to open; anything else means the first.
    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    protected override async Task OnInitializedAsync()
    {
        activeTab = PreferencesTabs.Normalize(Tab);

        try
        {
            user = await UserApi.GetCurrentUserAsync();
        }
        catch (GarageApiException)
        {
            // The account card shows "Not available"; the lookups still work.
        }

        try
        {
            lookups = (await LookupsApi.GetAsync(includeHidden: true)).Value;
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    // A refused change opens its tab so the message is not hidden in another one.
    private void Attend(string slug) => activeTab = PreferencesTabs.Normalize(slug);
}
