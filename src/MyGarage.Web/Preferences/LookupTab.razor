@inject LookupsApiClient Api
@inject NavigationManager Navigation

<div id="@PaneId" class="tab-pane card border-0 shadow-sm @(Active ? "show active" : null)" role="tabpanel" aria-labelledby="@($"{PaneId}-tab")" tabindex="0">
    <h2 class="card-header h6 mb-0">@Label</h2>

    <div class="card-body">
        @if (message is not null)
        {
            <div class="alert alert-warning" role="alert" data-testid="tab-message">@message</div>
        }

        <div class="row g-2 px-3 pb-2 fw-semibold small text-body-secondary" aria-hidden="true">
            <div class="col-6">Name</div>
            <div class="col-3">Item Type</div>
            <div class="col-3">Item Status</div>
        </div>
        <ul class="list-group">
            @foreach (var item in Items)
            {
                <li class="list-group-item @(item.IsHidden ? "text-body-secondary" : null)" data-testid="lookup-item" @key="item.Id">
                    <div class="row g-2 align-items-center">
                        <div class="col-6 text-break" data-testid="item-name">@item.Name</div>
                        <div class="col-3" data-testid="item-type">@(item.IsDefault ? "Default" : "Custom")</div>
                        <div class="col-3">
                            <form method="post" @formname="@($"toggle-{item.Id}")" @onsubmit="() => ToggleAsync(item)" data-testid="@($"toggle-{Slug}-{item.Id}")">
                                <AntiforgeryToken />
                                <div class="form-check form-switch mb-0">
                                    <input type="checkbox" role="switch" class="form-check-input" id="@($"switch-{item.Id}")" checked="@(!item.IsHidden)"
                                           data-auto-submit aria-label="@($"Show {item.Name}")" />
                                    <label class="form-check-label" for="@($"switch-{item.Id}")" data-testid="item-status">@(item.IsHidden ? "Hidden" : "Shown")</label>
                                </div>
                                <noscript><button type="submit" class="btn btn-outline-secondary btn-sm mt-1">Apply</button></noscript>
                            </form>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>

    <div class="card-footer">
        <EditForm EditContext="editContext" FormName="add" OnValidSubmit="AddAsync" data-testid="@($"add-lookup-{Slug}")" class="row g-2 align-items-center">
            <div class="col-sm-8 col-md-6">
                <div class="form-floating">
                    <InputText id="@($"{PaneId}-name")" class="form-control" @bind-Value="Model!.Name" maxlength="30" placeholder="New item" required
                               data-clear-error="@($"{PaneId}-error")"
                               aria-describedby="@(error is null ? null : $"{PaneId}-error")" />
                    <label for="@($"{PaneId}-name")">New item</label>
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary d-inline-flex align-items-center gap-2" title="Add a custom item to this list">
                    <Icon Name="IconName.Plus" /> Add item
                </button>
            </div>
        </EditForm>

        @if (error is not null)
        {
            <div id="@($"{PaneId}-error")" class="invalid-feedback d-block" role="alert">@error</div>
        }
    </div>
</div>

@code {
    private string? message;
    private string? error;
    private EditContext editContext = default!;

    // The lookup's route slug (see LookupKinds).
    [Parameter, EditorRequired]
    public string Slug { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Label { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<LookupItemDto> Items { get; set; } = [];

    // True for the tab that is open.
    [Parameter]
    public bool Active { get; set; }

    // Raised when a change is refused so the page can open this tab and the message is not hidden.
    [Parameter]
    public EventCallback<string> OnAttention { get; set; }

    // Supplied from the form scope the page wraps around this component, so each tab's add form is told apart.
    [SupplyParameterFromForm(FormName = "add")]
    private AddModel? Model { get; set; }

    private string PaneId => $"lookup-{Slug}";

    protected override void OnInitialized()
    {
        Model ??= new AddModel();
        editContext = new EditContext(Model);
    }

    private async Task AddAsync()
    {
        message = null;
        error = null;
        try
        {
            var result = await Api.AddAsync(Slug, Model!.Name);
            switch (result.Outcome)
            {
                case ApiOutcome.Success:
                    Navigation.NavigateTo(ReturnHref);
                    return;
                case ApiOutcome.Conflict:
                    error = result.Title ?? "The item could not be added.";
                    break;
                case ApiOutcome.Invalid:
                    error = result.Errors.Values.SelectMany(messages => messages).FirstOrDefault() ?? "The name is not valid.";
                    break;
                default:
                    message = "This list could not be found.";
                    break;
            }
        }
        catch (GarageApiException ex)
        {
            message = Describe(ex);
        }

        await OnAttention.InvokeAsync(Slug);
    }

    private async Task ToggleAsync(LookupItemDto item)
    {
        message = null;
        error = null;
        try
        {
            var result = await Api.SetVisibilityAsync(Slug, item.Id, !item.IsHidden);
            if (result.IsSuccess)
            {
                Navigation.NavigateTo(ReturnHref);
                return;
            }

            message = "That item could not be found. It may have been removed.";
        }
        catch (GarageApiException ex)
        {
            message = Describe(ex);
        }

        await OnAttention.InvokeAsync(Slug);
    }

    private string ReturnHref => $"/preferences?tab={Slug}";

    private static string Describe(GarageApiException ex) =>
        ex.Failure == GarageApiFailure.NotAccepted ? VehicleMessages.NotAccepted : VehicleMessages.Unavailable;

    public sealed class AddModel
    {
        public string? Name { get; set; }
    }
}
