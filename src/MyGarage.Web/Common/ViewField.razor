<div class="@Column">
    <div class="mg-view-field">
        <dt class="small fw-normal text-body-secondary">@Label</dt>
        @if (AddHref is not null && (string.IsNullOrWhiteSpace(Value) || Value == DisplayFormat.NotSet))
        {
            <dd class="mb-0"><a class="mg-add-link" href="@AddHref" data-testid="add-value" aria-label="Add @Label.ToLowerInvariant()">Add</a></dd>
        }
        else
        {
            <dd class="mb-0 text-break">@Value</dd>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = default!;

    [Parameter, EditorRequired]
    public string? Value { get; set; }

    // Matches the column the same field takes on the edit form.
    [Parameter]
    public string Column { get; set; } = "col-sm-4";

    // Where to add the value; an unset value then reads as an "Add" link instead of "Not set".
    [Parameter]
    public string? AddHref { get; set; }
}
