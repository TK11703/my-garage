@page "/api-check"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject GarageApiClient Api

<PageTitle>API check</PageTitle>

<h1 class="h3 mb-3">API check</h1>

@if (failure is not null)
{
    <div class="alert alert-warning" role="alert">
        @(failure == GarageApiFailure.NotAccepted ? ApiCheckMessages.NotAccepted : ApiCheckMessages.Unavailable)
    </div>

    @if (failure == GarageApiFailure.NotAccepted)
    {
        <a class="btn btn-primary" href="/authentication/login?returnUrl=%2Fapi-check">Sign in again</a>
    }
}
else if (user is not null && items is not null)
{
    <p>The API recognises you as <strong>@user.DisplayName</strong>.</p>

    <ul class="list-group">
        @foreach (var item in items)
        {
            <li class="list-group-item">@item.Name</li>
        }
    </ul>
}

@code {
    private CurrentUserDto? user;
    private List<SampleItemDto>? items;
    private GarageApiFailure? failure;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await Api.GetCurrentUserAsync();
            items = await Api.GetSampleDataAsync();
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }
}
