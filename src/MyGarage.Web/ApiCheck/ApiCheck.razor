@page "/api-check"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject GarageApiClient Api

<PageHeader Title="API Check" Trail="@(new[] { new Crumb("API check") })" />

@if (failure is not null)
{
    <ApiFailureAlert Failure="failure.Value" ReturnUrl="/api-check"
                     NotAcceptedMessage="@ApiCheckMessages.NotAccepted" UnavailableMessage="@ApiCheckMessages.Unavailable" />
}
else if (user is not null && items is not null)
{
    <p>The API recognises you as <strong>@user.DisplayName</strong>.</p>

    <ul class="list-group">
        @foreach (var item in items)
        {
            <li class="list-group-item">@item.Name</li>
        }
    </ul>
}

@code {
    private CurrentUserDto? user;
    private List<SampleItemDto>? items;
    private GarageApiFailure? failure;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await Api.GetCurrentUserAsync();
            items = await Api.GetSampleDataAsync();
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }
}
