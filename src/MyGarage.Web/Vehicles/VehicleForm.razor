@if (!Tabbed)
{
    <div class="row">
        <div class="col-lg-8">
            <EditForm EditContext="editContext" FormName="@FormName" OnValidSubmit="OnSubmit" class="vstack gap-3">
                <p class="form-text mb-0">* Required</p>
                <VehicleBasicFields Model="Model" Errors="Errors" Lookups="Lookups" />
                <VehicleSpecificationFields Model="Model" Errors="Errors" Lookups="Lookups" />
                <VehicleFormActions SubmitText="@SubmitText" CancelHref="@CancelHref" SubmitIcon="IconName.Save" />
            </EditForm>
        </div>
    </div>
}
else
{
    var current = CurrentTab();

    <TabNav Tabs="Tabs" Current="@current" />

    <EditForm EditContext="editContext" FormName="@FormName" OnValidSubmit="OnSubmit">
        <div class="tab-content">
            <div id="tab-details" class="tab-pane @PaneState("details", current)" role="tabpanel" aria-labelledby="tab-details-tab" tabindex="0">
                <FieldGroup Id="basic" Title="Basic">
                    <p class="form-text mb-2">* Required</p>
                    <div class="row">
                        <div class="col-lg-10 vstack gap-3">
                            <VehicleBasicFields Model="Model" Errors="Errors" Lookups="Lookups" Hints="Hints" />
                        </div>
                    </div>
                </FieldGroup>
                <FieldGroup Id="specifications" Title="Specifications">
                    <div class="row">
                        <div class="col-lg-10 vstack gap-3">
                            <VehicleSpecificationFields Model="Model" Errors="Errors" Lookups="Lookups" Hints="Hints" />
                        </div>
                    </div>
                </FieldGroup>
                <StickerFeaturesGroup Model="Model" Errors="Errors" />
                <VehicleFormActions SubmitText="@SubmitText" CancelHref="@CancelHref" SubmitIcon="IconName.Save" />
            </div>
        </div>
    </EditForm>

    @if (ImportContent is not null)
    {
        <div class="tab-content">
            <div id="tab-import" class="tab-pane card border-0 shadow-sm @PaneState("import", current)" role="tabpanel" aria-labelledby="tab-import-tab" tabindex="0">
                <div class="card-body">@ImportContent</div>
            </div>
        </div>
    }

    @if (AttachmentTabs)
    {
        <div class="tab-content">
            <div id="tab-media" class="tab-pane card border-0 shadow-sm @PaneState("media", current)" role="tabpanel" aria-labelledby="tab-media-tab" tabindex="0">
                <div class="card-body">@MediaContent</div>
            </div>
            <div id="tab-description" class="tab-pane @PaneState("description", current)" role="tabpanel" aria-labelledby="tab-description-tab" tabindex="0">@DescriptionContent</div>
        </div>
    }
}

@code {
    private static readonly string[] Fields = [.. VehicleFormFields.BasicFields, .. VehicleFormFields.SpecificationFields];

    private EditContext editContext = default!;
    private ValidationMessageStore messages = default!;
    private VehicleFormModel? contextModel;

    [Parameter, EditorRequired]
    public VehicleFormModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public string FormName { get; set; } = default!;

    [Parameter, EditorRequired]
    public string SubmitText { get; set; } = default!;

    [Parameter, EditorRequired]
    public string CancelHref { get; set; } = default!;

    // Validation errors returned by the API, keyed by property name.
    [Parameter]
    public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();

    // The choices offered by the lookup dropdowns.
    [Parameter]
    public VehicleFormLookups Lookups { get; set; } = VehicleFormLookups.Empty;

    [Parameter, EditorRequired]
    public EventCallback OnSubmit { get; set; }

    // Edit layout: the Details tab (Basic and Specifications groups) holds this form; Media and Description hold their own forms.
    [Parameter]
    public bool Tabbed { get; set; }

    // details, media, or description; anything else means details.
    [Parameter]
    public string? ActiveTab { get; set; }

    // False on the add page: pictures, tags, and the journal need a saved vehicle, so only the form tab is shown.
    [Parameter]
    public bool AttachmentTabs { get; set; } = true;

    // The Import from sticker pane; when null the form has no import tab.
    [Parameter]
    public RenderFragment? ImportContent { get; set; }

    // The sticker's own text for lookups it could not match, shown under the empty dropdowns.
    [Parameter]
    public StickerHints Hints { get; set; } = StickerHints.None;

    private IReadOnlyList<(string Id, string Label, IconName Icon)> Tabs => VehicleTabs.ForForm(ImportContent is not null, AttachmentTabs);

    [Parameter]
    public RenderFragment? MediaContent { get; set; }

    [Parameter]
    public RenderFragment? DescriptionContent { get; set; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(contextModel, Model))
        {
            contextModel = Model;
            editContext = new EditContext(Model);
            messages = new ValidationMessageStore(editContext);
            editContext.OnValidationRequested += (_, _) => messages.Clear();
        }

        messages.Clear();
        foreach (var field in Fields)
        {
            if (Errors.FirstOrDefault(pair => string.Equals(pair.Key, field, StringComparison.OrdinalIgnoreCase)).Value is { Length: > 0 } fieldErrors)
            {
                messages.Add(editContext.Field(field), fieldErrors);
            }
        }

        editContext.NotifyValidationStateChanged();
    }

    // A rejected save opens the tab that holds the first error so the message is not hidden.
    private string CurrentTab()
    {
        if (VehicleFormFields.HasError(Errors, Fields) || VehicleFormFields.HasStickerFeatureError(Errors))
        {
            return "details";
        }

        var requested = VehicleTabs.NormalizeForEdit(ActiveTab);
        if (requested == VehicleTabs.Import)
        {
            return ImportContent is null ? "details" : requested;
        }

        return !AttachmentTabs && requested is "media" or "description" ? "details" : requested;
    }

    private static string PaneState(string id, string current) => id == current ? "show active" : string.Empty;
}
