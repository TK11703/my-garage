@if (!Tabbed)
{
    <div class="row">
        <div class="col-lg-8">
            <EditForm EditContext="editContext" FormName="@FormName" OnValidSubmit="OnSubmit" class="vstack gap-3">
                <VehicleBasicFields Model="Model" Errors="Errors" />
                <VehicleSpecificationFields Model="Model" Errors="Errors" />
                <VehicleFormActions SubmitText="@SubmitText" CancelHref="@CancelHref" />
            </EditForm>
        </div>
    </div>
}
else
{
    var current = CurrentTab();

    <VehicleTabNav Current="@current" />

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <EditForm EditContext="editContext" FormName="@FormName" OnValidSubmit="OnSubmit">
                <div class="tab-content">
                    <div id="tab-basic" class="tab-pane @PaneState("basic", current)" role="tabpanel" aria-labelledby="tab-basic-tab" tabindex="0">
                        <div class="row">
                            <div class="col-lg-8 vstack gap-3">
                                <VehicleBasicFields Model="Model" Errors="Errors" />
                                <VehicleFormActions SubmitText="@SubmitText" CancelHref="@CancelHref" />
                            </div>
                        </div>
                    </div>
                    <div id="tab-specifications" class="tab-pane @PaneState("specifications", current)" role="tabpanel" aria-labelledby="tab-specifications-tab" tabindex="0">
                        <div class="row">
                            <div class="col-lg-8 vstack gap-3">
                                <VehicleSpecificationFields Model="Model" Errors="Errors" />
                                <VehicleFormActions SubmitText="@SubmitText" CancelHref="@CancelHref" />
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>

            <div class="tab-content">
                <div id="tab-media" class="tab-pane @PaneState("media", current)" role="tabpanel" aria-labelledby="tab-media-tab" tabindex="0">
                    @MediaContent
                </div>
                <div id="tab-description" class="tab-pane @PaneState("description", current)" role="tabpanel" aria-labelledby="tab-description-tab" tabindex="0">
                    <div class="row">
                        <div class="col-lg-8">
                            @DescriptionContent
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] Fields = [nameof(VehicleFormModel.Nickname), nameof(VehicleFormModel.Make), nameof(VehicleFormModel.Model),
        nameof(VehicleFormModel.Trim), nameof(VehicleFormModel.Color), nameof(VehicleFormModel.Mileage), nameof(VehicleFormModel.Doors)];

    private EditContext editContext = default!;
    private ValidationMessageStore messages = default!;
    private VehicleFormModel? contextModel;

    [Parameter, EditorRequired]
    public VehicleFormModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public string FormName { get; set; } = default!;

    [Parameter, EditorRequired]
    public string SubmitText { get; set; } = default!;

    [Parameter, EditorRequired]
    public string CancelHref { get; set; } = default!;

    // Validation errors returned by the API, keyed by property name.
    [Parameter]
    public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();

    [Parameter, EditorRequired]
    public EventCallback OnSubmit { get; set; }

    // Edit layout: Basic Info and Specifications share this form; Media and Description hold their own forms.
    [Parameter]
    public bool Tabbed { get; set; }

    // basic, specifications, media, or description; anything else means basic.
    [Parameter]
    public string? ActiveTab { get; set; }

    [Parameter]
    public RenderFragment? MediaContent { get; set; }

    [Parameter]
    public RenderFragment? DescriptionContent { get; set; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(contextModel, Model))
        {
            contextModel = Model;
            editContext = new EditContext(Model);
            messages = new ValidationMessageStore(editContext);
            editContext.OnValidationRequested += (_, _) => messages.Clear();
        }

        messages.Clear();
        foreach (var field in Fields)
        {
            if (Errors.FirstOrDefault(pair => string.Equals(pair.Key, field, StringComparison.OrdinalIgnoreCase)).Value is { Length: > 0 } fieldErrors)
            {
                messages.Add(editContext.Field(field), fieldErrors);
            }
        }

        editContext.NotifyValidationStateChanged();
    }

    // A rejected save opens the tab that holds the first error so the message is not hidden.
    private string CurrentTab()
    {
        if (VehicleFormFields.HasError(Errors, VehicleFormFields.BasicFields))
        {
            return "basic";
        }

        if (VehicleFormFields.HasError(Errors, VehicleFormFields.SpecificationFields))
        {
            return "specifications";
        }

        return VehicleTabs.Normalize(ActiveTab);
    }

    private static string PaneState(string id, string current) => id == current ? "show active" : string.Empty;
}
