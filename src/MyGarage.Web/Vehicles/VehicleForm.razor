<EditForm EditContext="editContext" FormName="@FormName" OnValidSubmit="OnSubmit" class="vstack gap-3">
    <div>
        <label for="nickname" class="form-label">Nickname</label>
        <InputText id="nickname" class="form-control" @bind-Value="Model.Nickname" maxlength="100"
                   aria-required="true" aria-describedby="@Described("Nickname")" />
        <ValidationMessage For="@(() => Model.Nickname)" id="nickname-error" class="invalid-feedback d-block" />
    </div>
    <div class="row g-3">
        <div class="col-sm-6">
            <label for="make" class="form-label">Make</label>
            <InputText id="make" class="form-control" @bind-Value="Model.Make" maxlength="50"
                       aria-required="true" aria-describedby="@Described("Make")" />
            <ValidationMessage For="@(() => Model.Make)" id="make-error" class="invalid-feedback d-block" />
        </div>
        <div class="col-sm-6">
            <label for="model" class="form-label">Model</label>
            <InputText id="model" class="form-control" @bind-Value="Model.Model" maxlength="50"
                       aria-required="true" aria-describedby="@Described("Model")" />
            <ValidationMessage For="@(() => Model.Model)" id="model-error" class="invalid-feedback d-block" />
        </div>
    </div>
    <div class="row g-3">
        <div class="col-sm-6">
            <label for="trim" class="form-label">Trim</label>
            <InputText id="trim" class="form-control" @bind-Value="Model.Trim" maxlength="50"
                       aria-describedby="@Described("Trim")" />
            <ValidationMessage For="@(() => Model.Trim)" id="trim-error" class="invalid-feedback d-block" />
        </div>
        <div class="col-sm-6">
            <label for="color" class="form-label">Color</label>
            <InputText id="color" class="form-control" @bind-Value="Model.Color" maxlength="30"
                       aria-describedby="@Described("Color")" />
            <ValidationMessage For="@(() => Model.Color)" id="color-error" class="invalid-feedback d-block" />
        </div>
    </div>
    <div class="row g-3">
        <div class="col-sm-6">
            <label for="mileage" class="form-label">Mileage (mi)</label>
            <InputNumber id="mileage" TValue="int?" class="form-control" @bind-Value="Model.Mileage" min="0" max="9999999" step="1" inputmode="numeric"
                         aria-describedby="@Described("Mileage")" />
            <ValidationMessage For="@(() => Model.Mileage)" id="mileage-error" class="invalid-feedback d-block" />
        </div>
        <div class="col-sm-6">
            <label for="doors" class="form-label">Doors</label>
            <InputNumber id="doors" TValue="int?" class="form-control" @bind-Value="Model.Doors" min="1" max="6" step="1" inputmode="numeric"
                         aria-describedby="@Described("Doors")" />
            <ValidationMessage For="@(() => Model.Doors)" id="doors-error" class="invalid-feedback d-block" />
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@SubmitText</button>
        <a class="btn btn-outline-secondary" href="@CancelHref">Cancel</a>
    </div>
</EditForm>

@code {
    private static readonly string[] Fields = [nameof(VehicleFormModel.Nickname), nameof(VehicleFormModel.Make), nameof(VehicleFormModel.Model),
        nameof(VehicleFormModel.Trim), nameof(VehicleFormModel.Color), nameof(VehicleFormModel.Mileage), nameof(VehicleFormModel.Doors)];

    private EditContext editContext = default!;
    private ValidationMessageStore messages = default!;
    private VehicleFormModel? contextModel;

    [Parameter, EditorRequired]
    public VehicleFormModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public string FormName { get; set; } = default!;

    [Parameter, EditorRequired]
    public string SubmitText { get; set; } = default!;

    [Parameter, EditorRequired]
    public string CancelHref { get; set; } = default!;

    // Validation errors returned by the API, keyed by property name.
    [Parameter]
    public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();

    [Parameter, EditorRequired]
    public EventCallback OnSubmit { get; set; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(contextModel, Model))
        {
            contextModel = Model;
            editContext = new EditContext(Model);
            messages = new ValidationMessageStore(editContext);
            editContext.OnValidationRequested += (_, _) => messages.Clear();
        }

        messages.Clear();
        foreach (var field in Fields)
        {
            if (Errors.FirstOrDefault(pair => string.Equals(pair.Key, field, StringComparison.OrdinalIgnoreCase)).Value is { Length: > 0 } fieldErrors)
            {
                messages.Add(editContext.Field(field), fieldErrors);
            }
        }

        editContext.NotifyValidationStateChanged();
    }

    private string? Described(string field) =>
        Errors.Keys.Any(key => string.Equals(key, field, StringComparison.OrdinalIgnoreCase)) ? $"{field.ToLowerInvariant()}-error" : null;
}
