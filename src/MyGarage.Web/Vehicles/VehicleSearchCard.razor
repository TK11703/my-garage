<div class="card border-0 shadow-sm mb-3 mg-search-card">
    <div class="card-body">
        <form id="vehicle-search" method="get" action="/search" role="search" aria-label="Search vehicles">
            <label for="q" class="form-label small fw-medium">Search</label>
            <div class="mg-search-field">
                <span class="mg-search-field-icon" aria-hidden="true"><Icon Name="IconName.Search" /></span>
                <input id="q" name="q" type="search" class="form-control" value="@Criteria.Query" maxlength="100"
                       placeholder="Search name, make, model, year, VIN, engine, trim, color, or tag" />
            </div>
            <button type="submit" class="visually-hidden">Search</button>
            @if (Criteria.HasStatus)
            {
                <input type="hidden" name="status" value="@Criteria.Status" />
            }
        </form>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public VehicleListCriteria Criteria { get; set; } = VehicleListCriteria.None;
}
