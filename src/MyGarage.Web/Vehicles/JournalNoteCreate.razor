@page "/vehicles/{VehicleId:guid}/journal/new"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using MyGarage.Web.Maintenance
@inject VehiclesApiClient Api
@inject NavigationManager Navigation

@if (failure is not null)
{
    <PageHeader Title="Add journal note" Trail="@(new[] { new Crumb("Vehicles") })" />

    <ApiFailureAlert Failure="failure.Value" ReturnUrl="@($"/vehicles/{VehicleId}/journal/new")"
                     NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
}
else if (notFound)
{
    <PageHeader Title="Vehicle not found" Trail="@(new[] { new Crumb("Vehicles") })" />

    <EmptyState Variant="EmptyStateVariant.NoMatch" Message="@VehicleMessages.NotFound"
                ActionText="Back to my vehicles" ActionHref="/vehicles" />
}
else if (vehicleName is not null)
{
    <PageHeader Title="Add journal note" Trail="@(new[] { new Crumb("Vehicles", "/vehicles"), new Crumb(vehicleName, $"/vehicles/{VehicleId}"), new Crumb("Add journal note") })" />

    <div class="row">
        <div class="col-lg-10">
            <MaintenanceFormCard Title="Journal note" FormId="create-note" SubmitText="Save" SubmitTitle="Save this note"
                                 CancelHref="@($"/vehicles/{VehicleId}?tab=timeline&kind=journal")">
                <EditForm EditContext="editContext" id="create-note" FormName="create-note" OnValidSubmit="SubmitAsync" class="vstack gap-3">
                    <div>
                        <div class="form-floating">
                            <InputTextArea id="note-body" class="form-control" maxlength="4000" placeholder=" " @bind-Value="Model!.Body"
                                           aria-required="true" />
                            <label for="note-body">Note<span class="text-danger" aria-hidden="true"> *</span></label>
                        </div>
                        <ValidationMessage For="@(() => Model.Body)" id="note-body-error" class="invalid-feedback d-block" />
                    </div>
                    <div class="col-sm-8 col-md-6">
                        <div class="form-floating">
                            <InputText id="note-category" class="form-control" maxlength="40" placeholder=" " @bind-Value="Model.Category" />
                            <label for="note-category">Category (optional)</label>
                        </div>
                        <ValidationMessage For="@(() => Model.Category)" id="note-category-error" class="invalid-feedback d-block" />
                    </div>
                </EditForm>
            </MaintenanceFormCard>
        </div>
    </div>
}

@code {
    private EditContext editContext = default!;
    private ValidationMessageStore messages = default!;
    private GarageApiFailure? failure;
    private string? vehicleName;
    private bool notFound;

    [Parameter]
    public Guid VehicleId { get; set; }

    [SupplyParameterFromForm(FormName = "create-note")]
    private NoteFormModel? Model { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model ??= new NoteFormModel();
        editContext = new EditContext(Model);
        messages = new ValidationMessageStore(editContext);
        editContext.OnValidationRequested += (_, _) => messages.Clear();

        try
        {
            var result = await Api.GetAsync(VehicleId);
            if (result.IsNotFound)
            {
                SetNotFound();
                return;
            }

            vehicleName = result.Value!.Name;
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private async Task SubmitAsync()
    {
        try
        {
            var result = await Api.CreateNoteAsync(VehicleId, new JournalNoteRequest { Body = Model!.Body, Category = Model.Category });
            if (result.IsSuccess)
            {
                Navigation.NavigateTo($"/vehicles/{VehicleId}?tab=timeline&kind=journal&saved=note");
                return;
            }

            if (result.IsNotFound)
            {
                SetNotFound();
                return;
            }

            foreach (var (field, errors) in result.Errors)
            {
                var property = field.Equals(nameof(NoteFormModel.Category), StringComparison.OrdinalIgnoreCase)
                    ? nameof(NoteFormModel.Category)
                    : nameof(NoteFormModel.Body);
                messages.Add(editContext.Field(property), errors);
            }

            editContext.NotifyValidationStateChanged();
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private void SetNotFound()
    {
        notFound = true;
        if (HttpContext is { Response.HasStarted: false })
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
