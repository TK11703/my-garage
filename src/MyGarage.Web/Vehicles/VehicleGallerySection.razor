@inject VehiclesApiClient Api
@inject NavigationManager Navigation

<section class="mt-2" aria-labelledby="gallery-heading">
    <h2 id="gallery-heading" class="visually-hidden">Pictures</h2>

    @if (Notice is { } notice)
    {
        <div class="alert alert-@notice.Level" role="@(notice.Level == "success" ? "status" : "alert")" data-testid="image-notice">@notice.Text</div>
    }

    @if (Images.Count >= MaxImages)
    {
        <p class="text-body-secondary" data-testid="image-limit">This vehicle has the maximum of @MaxImages pictures. Delete one to add another.</p>
    }
    else
    {
        <form method="post" action="/vehicles/@VehicleId/images" enctype="multipart/form-data" data-testid="upload-image" data-dropzone
              class="mg-dropzone d-flex flex-column align-items-center justify-content-center text-center p-4">
            <AntiforgeryToken />
            @if (OnEditPage)
            {
                <input type="hidden" name="returnTo" value="edit" />
            }
            <label for="image-file" class="visually-hidden">Choose pictures to upload</label>
            <input id="image-file" name="file" type="file" multiple accept="image/jpeg,image/png,image/webp" required aria-describedby="image-help" />
            <span class="mg-dropzone-icon" aria-hidden="true"><Icon Name="IconName.CloudUpload" Size="40" /></span>
            <span class="fw-semibold mt-3">Drag &amp; Drop Images Here</span>
            <span id="image-help" class="form-text mt-1">or click to browse. Supports JPG, PNG, WebP. Max 5MB per file, at most @MaxImages pictures per vehicle.</span>
            <noscript>
                <button type="submit" class="btn btn-outline-primary mt-3">Upload picture</button>
            </noscript>
        </form>
    }

    <h3 class="h6 mt-4" data-testid="uploaded-heading">Uploaded Images (@Images.Count)</h3>

    @if (Images.Count == 0)
    {
        <EmptyState Compact="true" Message="No pictures yet. Add one to show this vehicle in your garage." />
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3">
            @foreach (var image in Images)
            {
                var label = image.Caption ?? VehicleName;
                <div class="col" @key="image.Id" data-testid="image">
                    <div class="mg-image-tile">
                        <img src="/vehicles/@(VehicleId)/images/@(image.Id)" alt="@label" loading="lazy" />
                        @if (image.IsMain)
                        {
                            <span class="badge text-bg-primary mg-image-main" data-testid="main-badge">Main picture</span>
                        }
                        else
                        {
                            <form method="post" class="mg-image-main" @formname="@($"set-main-{image.Id}")" @onsubmit="() => SetMainAsync(image.Id)">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-light btn-sm" aria-label="Make @label the main picture">Make main</button>
                            </form>
                        }
                        @if (image.Caption is not null)
                        {
                            <span class="mg-image-caption text-break">@image.Caption</span>
                        }
                        <details class="mg-image-delete" data-testid="delete-image">
                            <summary class="btn btn-light btn-sm" aria-label="Delete picture @label"><Icon Name="IconName.Trash" /></summary>
                            <div class="mg-image-confirm" role="alert">
                                <p class="small mb-0">Delete this picture?</p>
                                <form method="post" @formname="@($"delete-image-{image.Id}")" @onsubmit="() => DeleteAsync(image.Id)" class="d-flex flex-wrap justify-content-center gap-2">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn btn-danger btn-sm">Yes, delete this picture</button>
                                    <a class="btn btn-outline-secondary btn-sm" href="@Back">Keep picture</a>
                                </form>
                            </div>
                        </details>
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    public const int MaxImages = 10;

    private string? failureText;

    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    [Parameter, EditorRequired]
    public string VehicleName { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<VehicleImageDto> Images { get; set; } = [];

    // Result of the last upload, passed back from the upload endpoint as a short code.
    [Parameter]
    public string? Status { get; set; }

    // Where to go after a change; defaults to the vehicle page.
    [Parameter]
    public string? ReturnPath { get; set; }

    private string Back => ReturnPath ?? $"/vehicles/{VehicleId}";

    private bool OnEditPage => ReturnPath is not null && ReturnPath.StartsWith($"/vehicles/{VehicleId}/edit", StringComparison.Ordinal);

    private (string Level, string Text)? Notice =>
        failureText is not null
            ? ("warning", failureText)
            : Status switch
            {
                VehicleImageEndpoints.Status.Uploaded => ("success", "Picture added."),
                VehicleImageEndpoints.Status.Invalid => ("danger", "That file is not a valid JPEG, PNG, or WebP picture."),
                VehicleImageEndpoints.Status.TooLarge => ("danger", "That picture is larger than 5 MB."),
                VehicleImageEndpoints.Status.Limit => ("danger", $"This vehicle already has {MaxImages} pictures. Delete one to add another."),
                VehicleImageEndpoints.Status.NotFound => ("warning", VehicleMessages.NotFound),
                VehicleImageEndpoints.Status.Unavailable => ("warning", "Picture storage is unavailable right now. Nothing was saved. Please try again shortly."),
                VehicleImageEndpoints.Status.SignIn => ("warning", VehicleMessages.NotAccepted),
                VehicleImageEndpoints.Status.Archived => ("warning", VehicleMessages.ArchivedCannotChange),
                _ => null,
            };

    private async Task SetMainAsync(Guid imageId) =>
        await ChangeAsync(() => Api.SetMainImageAsync(VehicleId, imageId));

    private async Task DeleteAsync(Guid imageId) =>
        await ChangeAsync(() => Api.DeleteImageAsync(VehicleId, imageId));

    private async Task ChangeAsync(Func<Task<ApiResult<bool>>> change)
    {
        try
        {
            await change();
            Navigation.NavigateTo(Back);
        }
        catch (GarageApiException ex)
        {
            failureText = VehicleMessages.For(ex.Failure);
        }
    }
}
