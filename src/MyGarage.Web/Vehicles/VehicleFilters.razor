<form method="get" action="/vehicles" role="search" aria-label="Search and filter vehicles" class="mb-3">
    @if (Errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
                @foreach (var message in Errors.Values.SelectMany(messages => messages))
                {
                    <li>@message</li>
                }
            </ul>
        </div>
    }

    <div class="input-group mb-2">
        <label for="q" class="visually-hidden">Search vehicles</label>
        <input id="q" name="q" type="search" class="form-control" value="@Criteria.Query" maxlength="100"
               placeholder="Search nickname, make, model, trim, color, or tag" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>

    <details open="@Criteria.HasFilters">
        <summary class="btn btn-outline-secondary btn-sm">Filters</summary>
        <div class="row g-3 mt-1">
            <div class="col-6 col-md-3">
                <label for="make" class="form-label">Make</label>
                <select id="make" name="make" class="form-select">
                    <option value="">Any</option>
                    @foreach (var make in WithCurrent(Options.Makes, Criteria.Make))
                    {
                        <option value="@make" selected="@Same(make, Criteria.Make)">@make</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="color" class="form-label">Color</label>
                <select id="color" name="color" class="form-select">
                    <option value="">Any</option>
                    @foreach (var color in WithCurrent(Options.Colors, Criteria.Color))
                    {
                        <option value="@color" selected="@Same(color, Criteria.Color)">@color</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="doors" class="form-label">Doors</label>
                <select id="doors" name="doors" class="form-select">
                    <option value="">Any</option>
                    @for (var doors = 1; doors <= 6; doors++)
                    {
                        <option value="@doors" selected="@(Criteria.Doors == doors)">@doors</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="tag" class="form-label">Tag</label>
                <select id="tag" name="tag" class="form-select">
                    <option value="">Any</option>
                    @foreach (var tag in WithCurrent(Options.Tags, Criteria.Tag))
                    {
                        <option value="@tag" selected="@Same(tag, Criteria.Tag)">@tag</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="minMileage" class="form-label">Minimum mileage</label>
                <input id="minMileage" name="minMileage" type="number" class="form-control" min="0" max="9999999" step="1" inputmode="numeric"
                       value="@Criteria.MinMileage" />
            </div>
            <div class="col-6 col-md-3">
                <label for="maxMileage" class="form-label">Maximum mileage</label>
                <input id="maxMileage" name="maxMileage" type="number" class="form-control" min="0" max="9999999" step="1" inputmode="numeric"
                       value="@Criteria.MaxMileage" />
            </div>
            <div class="col-12 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-secondary">Apply filters</button>
            </div>
        </div>
    </details>

    @if (Criteria.HasAny)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            <span class="text-body-secondary small">Active:</span>
            @foreach (var (key, label) in Criteria.Active())
            {
                <a class="badge text-bg-secondary text-decoration-none" data-testid="active-criterion"
                   href="@Criteria.Without(key).ToHref()" aria-label="Remove @label">@label <span aria-hidden="true">&times;</span></a>
            }
            <a class="small" href="/vehicles" data-testid="clear-all">Clear all</a>
        </div>
    }
</form>

@code {
    [Parameter, EditorRequired]
    public VehicleListCriteria Criteria { get; set; } = VehicleListCriteria.None;

    [Parameter, EditorRequired]
    public VehicleFilterOptionsDto Options { get; set; } = default!;

    // Validation messages from the API for criteria it rejected.
    [Parameter]
    public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();

    private static bool Same(string option, string? current) => string.Equals(option, current, StringComparison.OrdinalIgnoreCase);

    // A value from the URL that is no longer in the garage is still shown so the active filter is visible.
    private static IEnumerable<string> WithCurrent(IReadOnlyList<string> options, string? current) =>
        current is null || options.Any(option => Same(option, current)) ? options : options.Append(current);
}
