@using MyGarage.Shared.Reminders
@using MyGarage.Web.Common
@using MyGarage.Web.Reminders
@inject TimeProvider Time

<article class="card h-100 mg-vehicle-card @(Vehicle.ArchivedAt is null ? null : "mg-vehicle-card-archived")">
    <div class="mg-vehicle-top">
        @if (Vehicle.MainImageId is { } imageId)
        {
            <img class="mg-vehicle-photo card-img-top object-fit-cover" src="/vehicles/@(Vehicle.Id)/images/@(imageId)" alt="@Vehicle.Name" loading="lazy" />
        }
        else
        {
            <div class="mg-vehicle-photo mg-vehicle-placeholder" data-testid="vehicle-placeholder" role="img" aria-label="No picture for @Vehicle.Name">
                @if (Vehicle.Year is { } year)
                {
                    <span class="mg-vehicle-placeholder-year" aria-hidden="true">@year</span>
                }
                <span class="mg-vehicle-placeholder-model text-break" aria-hidden="true">@Vehicle.Model</span>
            </div>
        }
        @if (Pill is { } pill)
        {
            <span class="mg-status-pill mg-status-@pill.Key" data-testid="vehicle-status">@pill.Label</span>
        }
        <div class="mg-vehicle-plate">
            <h2 class="card-title h5 mb-0">
                <a class="stretched-link text-decoration-none text-break" href="/vehicles/@Vehicle.Id">@Vehicle.Name</a>
            </h2>
        </div>
    </div>
    <div class="card-body">
        @if (Vehicle.ArchivedAt is { } archivedAt)
        {
            <p class="mb-2"><span class="badge text-bg-light border fw-normal" data-testid="vehicle-archived">Archived @VehicleMessages.ArchivedOn(archivedAt)</span></p>
        }
        <dl class="mg-readouts">
            <div>
                <dt>Odometer</dt>
                <dd class="mg-num" data-testid="vehicle-mileage">@VehicleFormat.Mileage(Vehicle.Mileage)</dd>
            </div>
            @if (Vehicle.ArchivedAt is null)
            {
                <div data-testid="vehicle-next-due" class="mg-readout-next @(NextDueClass)">
                    @if (Vehicle.NextDue is { } due)
                    {
                        <dt>@due.Name</dt>
                        <dd class="mg-num">@VehicleFormat.NextDueRemaining(due)</dd>
                    }
                    else
                    {
                        <dt>Next due</dt>
                        <dd class="mg-readout-empty">No reminder set</dd>
                    }
                </div>
            }
            <div>
                <dt>Spent @Time.GetUtcNow().Year</dt>
                <dd class="mg-num" data-testid="vehicle-spend">@DisplayFormat.Money(Vehicle.SpendThisYear ?? 0m)</dd>
            </div>
        </dl>
        @if (Vehicle.FuelType is not null || Vehicle.Transmission is not null || Vehicle.PurchasedYear is not null)
        {
            <p class="mg-vehicle-tags card-text mb-0" data-testid="vehicle-badges">
                @if (Vehicle.FuelType is not null)
                {
                    <span class="badge bg-info-subtle text-info-emphasis fw-normal text-break" data-testid="vehicle-fuel">@Vehicle.FuelType</span>
                }
                @if (Vehicle.Transmission is not null)
                {
                    <span class="badge bg-primary-subtle text-primary-emphasis fw-normal text-break" data-testid="vehicle-transmission">@Vehicle.Transmission</span>
                }
                @if (Vehicle.PurchasedYear is { } purchasedYear)
                {
                    <span class="mg-vehicle-acquired d-inline-flex align-items-center gap-1" data-testid="vehicle-acquired">
                        <Icon Name="IconName.Calendar" />
                        <span>@VehicleFormat.Acquired(Vehicle.Ownership, purchasedYear)</span>
                    </span>
                }
            </p>
        }
    </div>
</article>

@code {
    private sealed record StatusPill(string Key, string Label);

    [Parameter, EditorRequired]
    public VehicleSummaryDto Vehicle { get; set; } = default!;

    // Only a reminder that needs attention gets a pill; an upcoming one is quiet.
    private StatusPill? Pill => Vehicle.ArchivedAt is not null ? null : Vehicle.NextDue?.Status switch
    {
        ReminderStatus.Overdue => new StatusPill("bad", "Overdue"),
        ReminderStatus.DueSoon => new StatusPill("due", "Due soon"),
        _ => null,
    };

    private string NextDueClass => Vehicle.NextDue?.Status switch
    {
        ReminderStatus.Overdue => "mg-readout-bad",
        ReminderStatus.DueSoon => "mg-readout-due",
        ReminderStatus.MileageNeeded => "mg-readout-needed",
        _ => string.Empty,
    };
}
