@page "/vehicles/{VehicleId:guid}"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject VehiclesApiClient Api
@inject NavigationManager Navigation

@if (failure is not null)
{
    <PageHeader Title="Vehicle" Trail="@(new[] { new Crumb("Vehicles") })" />

    <ApiFailureAlert Failure="failure.Value" ReturnUrl="@($"/vehicles/{VehicleId}")"
                     NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
}
else if (notFound)
{
    <PageHeader Title="Vehicle not found" Trail="@(new[] { new Crumb("Vehicles") })" />

    <EmptyState Variant="EmptyStateVariant.NoMatch" Message="@VehicleMessages.NotFound"
                ActionText="Back to my vehicles" ActionHref="/vehicles" />
}
else if (vehicle is not null)
{
    var current = VehicleTabs.Normalize(Tab);

    <PageHeader Title="@vehicle.Name" Trail="@(new[] { new Crumb("Vehicles", "/vehicles"), new Crumb(vehicle.Name) })">
        <Actions>
            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (!isArchived)
                {
                    <AddMaintenanceMenu VehicleId="VehicleId" />
                    <a class="btn btn-outline-primary d-inline-flex align-items-center gap-2" href="@EditHref(current)" data-tab-link data-testid="edit-vehicle" title="Edit this vehicle">
                        <Icon Name="IconName.Pencil" /> Edit
                    </a>
                    <details class="position-relative" data-testid="archive-vehicle">
                        <summary class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" title="Archive this vehicle">
                            <Icon Name="IconName.Archive" /> Archive
                        </summary>
                        <div class="alert alert-secondary mg-confirm-panel shadow" role="alert">
                            <p>Archive @vehicle.Name? It leaves your garage figures and its reminders are disabled, but all its history is kept and you can restore it any time.</p>
                            <form method="post" @formname="archive-vehicle" @onsubmit="ArchiveAsync" class="d-flex flex-wrap gap-2">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-primary">Yes, archive this vehicle</button>
                                <a class="btn btn-outline-secondary" href="/vehicles/@VehicleId">Keep vehicle active</a>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <details class="position-relative" data-testid="restore-vehicle">
                        <summary class="btn btn-outline-primary d-inline-flex align-items-center gap-2" title="Restore this vehicle">
                            <Icon Name="IconName.ArrowCounterclockwise" /> Restore
                        </summary>
                        <div class="alert alert-secondary mg-confirm-panel shadow" role="alert">
                            <p>Restore @vehicle.Name? It returns to your garage and its reminders are enabled again.</p>
                            <form method="post" @formname="restore-vehicle" @onsubmit="RestoreAsync" class="d-flex flex-wrap gap-2">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-primary">Yes, restore this vehicle</button>
                                <a class="btn btn-outline-secondary" href="/vehicles/@VehicleId">Keep archived</a>
                            </form>
                        </div>
                    </details>
                }
                <details class="position-relative" data-testid="delete-vehicle">
                    <summary class="btn btn-outline-danger d-inline-flex align-items-center gap-2" title="Delete this vehicle">
                        <Icon Name="IconName.Trash" /> Delete
                    </summary>
                    <div class="alert alert-danger mg-confirm-panel shadow" role="alert">
                        <p>Delete @vehicle.Name? This also removes its tags, journal notes, service records, charging and fueling entries, inspections, registrations, insurance, taxes, reminders, pictures, and kept documents and cannot be undone.@(isArchived ? "" : " To keep the history instead, archive the vehicle.")</p>
                        <form method="post" @formname="delete-vehicle" @onsubmit="DeleteAsync" class="d-flex flex-wrap gap-2">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-danger">Yes, delete this vehicle</button>
                            <a class="btn btn-outline-secondary" href="/vehicles/@VehicleId">Keep vehicle</a>
                        </form>
                    </div>
                </details>
            </div>
        </Actions>
    </PageHeader>

    @if (Saved == "draft")
    {
        <div class="alert alert-success" role="status" data-testid="draft-saved">The record was saved from your email draft.</div>
    }

    @if (VehicleMessages.SavedNotice(Saved) is { } savedNotice)
    {
        <div class="alert alert-success" role="status" data-testid="vehicle-saved">@savedNotice</div>
    }

    @if (stateMessage is not null)
    {
        <div class="alert alert-warning" role="status" data-testid="state-message">@stateMessage</div>
    }

    @if (vehicle.ArchivedAt is { } archivedAt)
    {
        <div class="alert alert-warning" role="status" data-testid="archived-alert">
            <span class="badge text-bg-secondary me-2" data-testid="archived-badge">Archived</span>
            This vehicle was archived on @VehicleMessages.ArchivedOn(archivedAt). Its history is kept but it cannot be changed, and it is not counted in your garage figures except fuel and charging.
        </div>
    }

    @if (vehicle.Year is null)
    {
        <div class="alert alert-warning" role="alert" data-testid="missing-year">
            This vehicle has no year yet. <a class="alert-link" href="/vehicles/@VehicleId/edit?tab=details">Add the year</a> to complete its details.
        </div>
    }

    <VehicleTabNav Current="@current" />

    <div class="tab-content">
        <CascadingValue Value="archivedState">
                <div id="tab-details" class="tab-pane @PaneState("details", current)" role="tabpanel" aria-labelledby="tab-details-tab" tabindex="0">
                    <FieldGroup Id="basic" Title="Basic">
                    <dl class="row g-3 mb-0" aria-label="Basic information">
                        <ViewField Label="Year" Value="@VehicleFormat.Number(vehicle.Year)" />
                        <ViewField Label="Make" Value="@vehicle.Make" />
                        <ViewField Label="Model" Value="@vehicle.Model" />
                        <ViewField Label="Trim" Value="@VehicleFormat.Text(vehicle.Trim)" />
                        <ViewField Label="VIN" Value="@VehicleFormat.Text(vehicle.Vin)" />
                        <ViewField Label="Vehicle type" Value="@VehicleFormat.Text(vehicle.VehicleType?.Name)" />
                        <ViewField Label="Purchased or leased" Value="@VehicleFormat.Ownership(vehicle.Ownership)" />
                        <ViewField Label="@VehicleFormat.DateLabel(vehicle.Ownership)" Value="@VehicleFormat.Date(vehicle.PurchasedOn)" />
                        @if (vehicle.Ownership == OwnershipType.Leased)
                        {
                            <ViewField Label="Date lease ends" Value="@VehicleFormat.Date(vehicle.LeaseEndsOn)" />
                        }
                        <ViewField Label="@VehicleFormat.MileageLabel(vehicle.Ownership)" Value="@VehicleFormat.MileageOrNotSet(vehicle.Mileage)" />
                        <ViewField Label="Latest odometer reading" Value="@VehicleFormat.MileageOrNotSet(vehicle.LatestOdometerReading)" />
                    </dl>
                    </FieldGroup>
                    <FieldGroup Id="specifications" Title="Specifications">
                    <dl class="row g-3 mb-0" aria-label="Specifications">
                        <ViewField Label="Engine" Value="@VehicleFormat.Text(vehicle.Engine)" />
                        <ViewField Label="Horsepower" Value="@VehicleFormat.Horsepower(vehicle.Horsepower)" />
                        <ViewField Label="Drivetrain" Value="@VehicleFormat.Text(vehicle.Drivetrain?.Name)" />
                        <ViewField Label="Color" Value="@VehicleFormat.Text(vehicle.Color)" />
                        <ViewField Label="Fuel type" Value="@VehicleFormat.Text(vehicle.FuelType?.Name)" />
                        <ViewField Label="Transmission" Value="@VehicleFormat.Text(vehicle.Transmission?.Name)" />
                        <ViewField Label="Seats" Value="@VehicleFormat.Number(vehicle.Seats)" Column="col-6 col-sm-3" />
                        <ViewField Label="Doors" Value="@VehicleFormat.Number(vehicle.Doors)" Column="col-6 col-sm-3" />
                        <ViewField Label="Wheel size" Value="@VehicleFormat.WheelSize(vehicle.WheelSize)" Column="col-6 col-sm-3" />
                        <ViewField Label="Tire size" Value="@VehicleFormat.Text(vehicle.TireSize)" Column="col-6 col-sm-3" />
                    </dl>
                    </FieldGroup>
                </div>
                <div id="tab-media" class="tab-pane @PaneState("media", current)" role="tabpanel" aria-labelledby="tab-media-tab" tabindex="0">
                    <VehicleGalleryView VehicleId="VehicleId" VehicleName="@vehicle.Name" Images="vehicle.Images" />
                </div>
                <div id="tab-description" class="tab-pane @PaneState("description", current)" role="tabpanel" aria-labelledby="tab-description-tab" tabindex="0">
                    <div class="row g-4">
                        <div class="col-lg-8">
                            <VehicleTagsView VehicleId="VehicleId" Tags="vehicle.Tags" Query="@FeatureQuery" />
                        </div>
                        <div class="col-lg-4">
                            <VehicleJournalView VehicleId="VehicleId" NotesPage="journalPage" />
                        </div>
                    </div>
                </div>
                <div id="tab-service-records" class="tab-pane @PaneState("service-records", current)" role="tabpanel" aria-labelledby="tab-service-records-tab" tabindex="0">
                    <MaintenanceView VehicleId="VehicleId" Section="MaintenanceLinks.ParseSection(Section)" RecordsPage="recordsPage"
                                     FuelPage="MaintenanceLinks.ParsePage(FuelPage)" InspectionsPage="MaintenanceLinks.ParsePage(InspectionsPage)"
                                     RegistrationsPage="MaintenanceLinks.ParsePage(RegistrationsPage)" InsurancePage="MaintenanceLinks.ParsePage(InsurancePage)"
                                     TaxesPage="MaintenanceLinks.ParsePage(TaxesPage)" DocumentsPage="MaintenanceLinks.ParsePage(DocumentsPage)" />
                </div>
                <div id="tab-reminders" class="tab-pane @PaneState("reminders", current)" role="tabpanel" aria-labelledby="tab-reminders-tab" tabindex="0">
                    <ReminderTab VehicleId="VehicleId" Saved="@Saved" />
                </div>
        </CascadingValue>
    </div>

}

@code {
    private VehicleDetailDto? vehicle;
    private bool notFound;
    private GarageApiFailure? failure;
    private string? stateMessage;

    private bool isArchived => vehicle?.ArchivedAt is not null;

    private VehicleArchivedState archivedState => isArchived ? VehicleArchivedState.Archived : VehicleArchivedState.Active;

    // The edit form opens on the tab being viewed (it has no Maintenance tab, so that one and Details open on Details).
    private string EditHref(string tab) =>
        tab is "media" or "description" ? $"/vehicles/{VehicleId}/edit?tab={tab}" : $"/vehicles/{VehicleId}/edit";

    [Parameter]
    public Guid VehicleId { get; set; }

    // Which tab to open: details, media, description, service-records (shown as Maintenance), or reminders.
    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    // Read as text: a bad query value must mean the first page of notes, not a binding error.
    [Parameter, SupplyParameterFromQuery(Name = "notesPage")]
    public string? NotesPage { get; set; }

    private int journalPage => int.TryParse(NotesPage, out var parsed) ? Math.Max(1, parsed) : 1;

    // Read as text: a bad query value must mean the first page of records, not a binding error.
    [Parameter, SupplyParameterFromQuery(Name = "recordsPage")]
    public string? RecordsPage { get; set; }

    private int recordsPage => int.TryParse(RecordsPage, out var parsedPage) ? Math.Max(1, parsedPage) : 1;

    // Which Maintenance accordion item starts open: records (default), fuel, or compliance.
    [Parameter, SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    // Each Maintenance list pages on its own query value, read as text like the others.
    [Parameter, SupplyParameterFromQuery(Name = "fuelPage")]
    public string? FuelPage { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "inspectionsPage")]
    public string? InspectionsPage { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "registrationsPage")]
    public string? RegistrationsPage { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "insurancePage")]
    public string? InsurancePage { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "taxesPage")]
    public string? TaxesPage { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "documentsPage")]
    public string? DocumentsPage { get; set; }

    // The text typed into the feature search on the Description tab.
    [Parameter, SupplyParameterFromQuery(Name = "featureQuery")]
    public string? FeatureQuery { get; set; }

    // Set to "draft" when a record was just saved from an email draft.
    [Parameter, SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    private static string PaneState(string id, string current) => id == current ? "show active" : string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.GetAsync(VehicleId);
            vehicle = result.Value;
            notFound = result.IsNotFound;

            if (notFound && HttpContext is { Response.HasStarted: false })
            {
                HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            }
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private async Task ArchiveAsync() => await ChangeStateAsync(Api.ArchiveAsync, "archived", VehicleMessages.AlreadyArchived);

    private async Task RestoreAsync() => await ChangeStateAsync(Api.RestoreAsync, "restored", VehicleMessages.AlreadyActive);

    // Success goes back to the vehicle page with a notice; a 409 means another tab already made the change, so the page shows the vehicle as it is now.
    private async Task ChangeStateAsync(Func<Guid, CancellationToken, Task<ApiResult<VehicleDetailDto>>> change, string saved, string alreadyMessage)
    {
        try
        {
            var result = await change(VehicleId, CancellationToken.None);
            if (result.IsSuccess)
            {
                Navigation.NavigateTo($"/vehicles/{VehicleId}?saved={saved}");
            }
            else if (result.IsNotFound)
            {
                notFound = true;
                vehicle = null;
            }
            else if (result.Outcome == ApiOutcome.Conflict)
            {
                stateMessage = alreadyMessage;
                vehicle = (await Api.GetAsync(VehicleId)).Value;
            }
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            var result = await Api.DeleteAsync(VehicleId);
            if (result.IsSuccess || result.IsNotFound)
            {
                Navigation.NavigateTo("/vehicles");
            }
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }
}
