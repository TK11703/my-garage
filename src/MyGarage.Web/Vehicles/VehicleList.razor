@page "/vehicles"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject VehiclesApiClient Api

<PageHeader Title="My Vehicles" Trail="@(new[] { new Crumb("Vehicles") })">
    <Actions>
        <a class="btn btn-primary d-inline-flex align-items-center gap-2" href="/vehicles/new" data-testid="add-vehicle" title="Add a new vehicle">
            <Icon Name="IconName.Plus" /> Add vehicle
        </a>
    </Actions>
</PageHeader>

@if (failure is not null)
{
    <ApiFailureAlert Failure="failure.Value" ReturnUrl="/vehicles"
                     NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
}
else if (vehicles is not null)
{
    @if (vehicles.TotalCount == 0 && !criteria.HasAny && errors.Count == 0)
    {
        <EmptyState Message="You have no vehicles yet." ActionText="Add your first vehicle" ActionHref="/vehicles/new" />
    }
    else
    {
        <VehicleSearchCard Criteria="criteria" />

        <section class="card border-0 shadow-sm mg-results" aria-label="Vehicles">
            <div class="card-header bg-transparent py-3">
                <p class="mb-0 text-body-secondary" aria-live="polite" data-testid="result-summary">@Summary</p>
            </div>

            @if (errors.Count > 0)
            {
                <div class="alert alert-danger m-3 mb-0" role="alert">
                    <ul class="mb-0">
                        @foreach (var message in errors.Values.SelectMany(messages => messages))
                        {
                            <li>@message</li>
                        }
                    </ul>
                </div>
            }

            @if (vehicles.TotalCount == 0)
            {
                <div class="card-body">
                    <EmptyState Variant="EmptyStateVariant.NoMatch" Message="No vehicles match your search."
                                ActionText="Clear search" ActionHref="/vehicles" data-testid="no-match-clear" />
                </div>
            }
            else
            {
                <div class="card-body">
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
                        @foreach (var vehicle in vehicles.Items)
                        {
                            <div class="col" @key="vehicle.Id">
                                <VehicleCard Vehicle="vehicle" />
                            </div>
                        }
                    </div>
                </div>

                <div class="card-footer bg-transparent d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <p class="mb-0 text-body-secondary small" data-testid="showing-range">@ShowingRange</p>
                    <Pager Page="vehicles.Page" TotalPages="vehicles.TotalPages" JustifyEnd="true"
                           HrefFor="@(p => $"/vehicles?{criteria.ToQueryString(p)}")" />
                </div>
            }
        </section>
    }
}

@code {
    private PagedResultDto<VehicleSummaryDto>? vehicles;
    private VehicleListCriteria criteria = VehicleListCriteria.None;
    private IReadOnlyDictionary<string, string[]> errors = new Dictionary<string, string[]>();
    private GarageApiFailure? failure;

    // Query-string values are read as text: a bad value must be ignored, not throw a binding error.
    [Parameter, SupplyParameterFromQuery(Name = "page")]
    public string? Page { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    private string Summary => vehicles!.TotalCount == 1 ? "1 vehicle found" : $"{vehicles.TotalCount} vehicles found";

    private string ShowingRange
    {
        get
        {
            var from = (vehicles!.Page - 1) * vehicles.PageSize + 1;
            var to = Math.Min(vehicles.Page * vehicles.PageSize, vehicles.TotalCount);
            return $"Showing {from} to {to} of {vehicles.TotalCount} entries";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        criteria = VehicleListCriteria.FromQuery(Q, null, null, null, null, null, null);
        var requestedPage = int.TryParse(Page, out var parsed) ? Math.Max(1, parsed) : 1;
        errors = new Dictionary<string, string[]>();

        try
        {
            var result = await Api.ListAsync(criteria, requestedPage);
            if (result.Outcome == ApiOutcome.Invalid)
            {
                // Show why the criteria were rejected and fall back to the whole garage.
                errors = result.Errors;
                criteria = VehicleListCriteria.None;
                result = await Api.ListAsync(criteria, requestedPage);
            }

            vehicles = result.Value;
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }
}
