<div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary @(SubmitIcon is null ? null : "d-inline-flex align-items-center gap-2")" data-busy-text="Saving..." title="@SubmitTitle">
        @if (SubmitIcon is { } icon)
        {
            <Icon Name="icon" />
        }
        @SubmitText
    </button>
    <a class="btn btn-outline-secondary" href="@CancelHref" title="@CancelTitle">Cancel</a>
</div>

@code {
    [Parameter, EditorRequired]
    public string SubmitText { get; set; } = default!;

    [Parameter, EditorRequired]
    public string CancelHref { get; set; } = default!;

    [Parameter]
    public IconName? SubmitIcon { get; set; }

    [Parameter]
    public string? SubmitTitle { get; set; }

    [Parameter]
    public string? CancelTitle { get; set; }
}
