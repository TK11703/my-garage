<div class="row g-3">
    <div class="col-sm-4">
        <div class="form-floating">
            <InputNumber id="year" TValue="int?" class="form-control" @bind-Value="Model.Year" min="1900" max="@(DateTime.UtcNow.Year + 1)" step="1" inputmode="numeric" placeholder=" "
                         aria-required="true" aria-describedby="@VehicleFormFields.Described(Errors, "Year")" />
            <label for="year">Year<span class="text-danger" aria-hidden="true"> *</span></label>
        </div>
        <ValidationMessage For="@(() => Model.Year)" id="year-error" class="invalid-feedback d-block" />
    </div>
    <div class="col-sm-4">
        <div class="form-floating">
            <InputText id="make" class="form-control" @bind-Value="Model.Make" maxlength="50" placeholder=" "
                       aria-required="true" aria-describedby="@VehicleFormFields.Described(Errors, "Make")" />
            <label for="make">Make<span class="text-danger" aria-hidden="true"> *</span></label>
        </div>
        <ValidationMessage For="@(() => Model.Make)" id="make-error" class="invalid-feedback d-block" />
    </div>
    <div class="col-sm-4">
        <div class="form-floating">
            <InputText id="model" class="form-control" @bind-Value="Model.Model" maxlength="50" placeholder=" "
                       aria-required="true" aria-describedby="@VehicleFormFields.Described(Errors, "Model")" />
            <label for="model">Model<span class="text-danger" aria-hidden="true"> *</span></label>
        </div>
        <ValidationMessage For="@(() => Model.Model)" id="model-error" class="invalid-feedback d-block" />
    </div>
</div>
<div class="row g-3">
    <div class="col-sm-4">
        <div class="form-floating">
            <InputText id="trim" class="form-control" @bind-Value="Model.Trim" maxlength="50" placeholder=" "
                       aria-describedby="@VehicleFormFields.Described(Errors, "Trim")" />
            <label for="trim">Trim</label>
        </div>
        <ValidationMessage For="@(() => Model.Trim)" id="trim-error" class="invalid-feedback d-block" />
    </div>
    <div class="col-sm-4">
        <div class="form-floating">
            <InputText id="vin" class="form-control text-uppercase" @bind-Value="Model.Vin" maxlength="17" autocomplete="off" placeholder=" "
                       aria-describedby="@VehicleFormFields.Described(Errors, "Vin")" />
            <label for="vin">VIN</label>
        </div>
        <ValidationMessage For="@(() => Model.Vin)" id="vin-error" class="invalid-feedback d-block" />
    </div>
    <div class="col-sm-4">
        <div class="form-floating">
            <InputSelect id="vehicle-type" TValue="Guid?" class="form-select" @bind-Value="Model.VehicleTypeId"
                         aria-describedby="@VehicleFormFields.Described(Errors, "VehicleTypeId")">
                <option value="">Not set</option>
                @foreach (var item in Lookups.VehicleTypes)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </InputSelect>
            <label for="vehicle-type">Vehicle type</label>
        </div>
        <ValidationMessage For="@(() => Model.VehicleTypeId)" id="vehicletypeid-error" class="invalid-feedback d-block" />
    </div>
</div>
<div class="row g-3">
    <div class="col-sm-4">
        <div class="form-floating">
            <InputSelect id="ownership" TValue="OwnershipType?" class="form-select" @bind-Value="Model.Ownership"
                         data-lease-source="lease-ends-field"
                         aria-describedby="@VehicleFormFields.Described(Errors, "Ownership")">
                <option value="">Not set</option>
                <option value="@OwnershipType.Purchased">Purchased</option>
                <option value="@OwnershipType.Leased">Leased</option>
            </InputSelect>
            <label for="ownership">Purchased or leased</label>
        </div>
        <ValidationMessage For="@(() => Model.Ownership)" id="ownership-error" class="invalid-feedback d-block" />
    </div>
    <div class="col-sm-4">
        <div class="form-floating">
            <InputDate id="purchased-on" TValue="DateOnly?" class="form-control" @bind-Value="Model.PurchasedOn" placeholder=" "
                       aria-describedby="@VehicleFormFields.Described(Errors, "PurchasedOn")" />
            <label for="purchased-on" data-ownership-text data-purchased="@VehicleFormat.DateLabel(OwnershipType.Purchased)"
                   data-leased="@VehicleFormat.DateLabel(OwnershipType.Leased)" data-unset="@VehicleFormat.DateLabel(null)">@VehicleFormat.DateLabel(Model.Ownership)</label>
        </div>
        <ValidationMessage For="@(() => Model.PurchasedOn)" id="purchasedon-error" class="invalid-feedback d-block" />
    </div>
    @* Only leased vehicles have a lease end; the ownership script shows and hides it as the choice above changes. *@
    <div id="lease-ends-field" class="col-sm-4" hidden="@(Model.Ownership != OwnershipType.Leased)">
        <div class="form-floating">
            <InputDate id="lease-ends-on" TValue="DateOnly?" class="form-control" @bind-Value="Model.LeaseEndsOn" placeholder=" "
                       aria-describedby="@VehicleFormFields.Described(Errors, "LeaseEndsOn")" />
            <label for="lease-ends-on">Date lease ends</label>
        </div>
        <ValidationMessage For="@(() => Model.LeaseEndsOn)" id="leaseendson-error" class="invalid-feedback d-block" />
    </div>
</div>
<div class="row g-3">
    <div class="col-sm-4">
        <div class="form-floating">
            <InputNumber id="mileage" TValue="int?" class="form-control" @bind-Value="Model.Mileage" min="0" max="9999999" step="1" inputmode="numeric" placeholder=" "
                         aria-describedby="@VehicleFormFields.Described(Errors, "Mileage")" />
            <label for="mileage" data-ownership-text data-purchased="@VehicleFormat.MileageLabel(OwnershipType.Purchased)"
                   data-leased="@VehicleFormat.MileageLabel(OwnershipType.Leased)" data-unset="@VehicleFormat.MileageLabel(null)">@VehicleFormat.MileageLabel(Model.Ownership)</label>
        </div>
        <ValidationMessage For="@(() => Model.Mileage)" id="mileage-error" class="invalid-feedback d-block" />
    </div>
    <div class="col-sm-4">
        <div class="form-floating">
            <InputNumber id="latest-odometer-reading" TValue="int?" class="form-control" @bind-Value="Model.LatestOdometerReading" min="0" max="9999999" step="1" inputmode="numeric" placeholder=" "
                         aria-describedby="@LatestDescribedBy" />
            <label for="latest-odometer-reading">Latest odometer reading</label>
        </div>
        <ValidationMessage For="@(() => Model.LatestOdometerReading)" id="latestodometerreading-error" class="invalid-feedback d-block" />
        <div id="latest-odometer-help" class="form-text">Shown on your garage card unless a newer service record has a higher reading.</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public VehicleFormModel Model { get; set; } = default!;

    [Parameter]
    public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();

    [Parameter]
    public VehicleFormLookups Lookups { get; set; } = VehicleFormLookups.Empty;

    private string LatestDescribedBy =>
        VehicleFormFields.Described(Errors, "LatestOdometerReading") is { } error ? $"{error} latest-odometer-help" : "latest-odometer-help";
}
