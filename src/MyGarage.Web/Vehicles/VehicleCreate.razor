@page "/vehicles/new"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject VehiclesApiClient Api
@inject LookupsApiClient LookupsApi
@inject StickerImportApiClient StickerApi
@inject NavigationManager Navigation

<PageHeader Title="Add Vehicle" Trail="@(new[] { new Crumb("Vehicles", "/vehicles"), new Crumb("New vehicle") })" />

@if (failure is not null)
{
    <ApiFailureAlert Failure="failure.Value" ReturnUrl="/vehicles/new"
                     NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
}

@if (!lookupsFailed)
{
    <VehicleForm Tabbed="true" AttachmentTabs="false" ActiveTab="@activeTab" Model="Model" FormName="create-vehicle" SubmitText="Save" CancelHref="/vehicles"
                 Lookups="lookups" Errors="errors" Hints="hints" OnSubmit="SubmitAsync">
        <ImportContent>
            <StickerImportPanel Existing="false" Result="importResult" Message="@importMessage" Level="@importLevel" OnImport="ImportAsync" />
        </ImportContent>
    </VehicleForm>
}

@code {
    private IReadOnlyDictionary<string, string[]> errors = new Dictionary<string, string[]>();
    private GarageApiFailure? failure;
    private VehicleFormLookups lookups = VehicleFormLookups.Empty;
    private bool lookupsFailed;
    // The add form opens on the import tab until an import or a rejected save moves it to the details.
    private string activeTab = VehicleTabs.Import;
    private StickerImportResultDto? importResult;
    private string? importMessage;
    private string importLevel = "danger";
    private StickerHints hints = StickerHints.None;

    [SupplyParameterFromForm(FormName = "create-vehicle")]
    private VehicleFormModel? Model { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model ??= new VehicleFormModel();
        if (HttpContext is { Request.HasFormContentType: true } http)
        {
            Model.StickerFeatures = StickerFeatureChoice.ReadFrom(http.Request.Form);
        }

        try
        {
            lookups = VehicleFormLookups.From((await LookupsApi.GetAsync(includeHidden: false)).Value!);
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
            lookupsFailed = true;
        }
    }

    private async Task ImportAsync()
    {
        failure = null;
        try
        {
            var attempt = await StickerImportHandler.RunAsync(HttpContext, StickerApi, null, HttpContext?.RequestAborted ?? default);
            importMessage = attempt.Message;
            importLevel = attempt.Level;
            importResult = attempt.Result;
            if (attempt.Result is { Outcome: not StickerImportOutcome.NoDetailsFound } result)
            {
                Model!.ApplyImport(result);
                hints = StickerHints.From(result);
                activeTab = "details";
            }
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private async Task SubmitAsync()
    {
        failure = null;
        try
        {
            var result = await Api.CreateAsync(Model!.ToRequest());
            if (result.IsSuccess)
            {
                Navigation.NavigateTo($"/vehicles/{result.Value!.Id}");
                return;
            }

            errors = result.Errors;
            activeTab = "details";
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
            activeTab = "details";
        }
    }
}
