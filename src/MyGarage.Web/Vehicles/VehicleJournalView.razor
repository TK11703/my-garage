@using System.Globalization
@inject VehiclesApiClient Api

<section class="card border-0 shadow-sm" aria-labelledby="recent-entries-heading">
    <h2 id="recent-entries-heading" class="card-header h6 mb-0">Recent Journal Entries</h2>
    <div class="card-body">
        @if (failure is not null)
        {
            <ApiFailureAlert Failure="failure.Value" ReturnUrl="@ReturnHref(NotesPage)"
                             NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
        }
        else if (notes is not null)
        {
            @if (notes.TotalCount == 0)
            {
                <p class="text-body-secondary mb-0">No notes yet. <a href="/vehicles/@VehicleId/edit?tab=description">Add a note</a></p>
            }
            else
            {
                <ul class="mg-timeline" aria-labelledby="recent-entries-heading">
                    @foreach (var note in notes.Items)
                    {
                        <li @key="note.Id" data-testid="note" class="mg-timeline-item">
                            <span class="mg-timeline-marker" aria-hidden="true"></span>
                            <time class="mg-timeline-time" datetime="@note.CreatedAt.UtcDateTime.ToString("O", CultureInfo.InvariantCulture)">
                                @note.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) UTC@(Edited(note) ? " (edited)" : null)
                            </time>
                            <p class="text-break mb-0">
                                @if (note.Category is not null)
                                {
                                    <span class="badge text-bg-info fw-normal me-1" data-testid="note-category">@note.Category</span>
                                }
                                <span class="note-body">@note.Body</span>
                            </p>
                        </li>
                    }
                </ul>

                <Pager Page="notes.Page" TotalPages="notes.TotalPages" HrefFor="@(p => ReturnHref(p))" />
            }
        }
    </div>
</section>

@code {
    private PagedResultDto<JournalNoteDto>? notes;
    private GarageApiFailure? failure;

    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    // The page of notes to show (1-based).
    [Parameter]
    public int NotesPage { get; set; } = 1;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var result = await Api.ListNotesAsync(VehicleId, Math.Max(1, NotesPage));
            notes = result.Value;
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private static bool Edited(JournalNoteDto note) => note.UpdatedAt - note.CreatedAt > TimeSpan.FromSeconds(1);

    // Page 1 has no page number so the address stays tidy.
    private string ReturnHref(int page) =>
        page <= 1 ? $"/vehicles/{VehicleId}?tab=description" : $"/vehicles/{VehicleId}?tab=description&notesPage={page}";
}
