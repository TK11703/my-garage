@page "/vehicles/{VehicleId:guid}/edit"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject VehiclesApiClient Api
@inject LookupsApiClient LookupsApi
@inject StickerImportApiClient StickerApi
@inject NavigationManager Navigation

@if (failure is not null)
{
    <PageHeader Title="Edit Vehicle" Trail="@(new[] { new Crumb("Vehicles") })" />

    <ApiFailureAlert Failure="failure.Value" ReturnUrl="@($"/vehicles/{VehicleId}/edit")"
                     NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
}
else if (notFound)
{
    <PageHeader Title="Vehicle not found" Trail="@(new[] { new Crumb("Vehicles") })" />

    <EmptyState Variant="EmptyStateVariant.NoMatch" Message="@VehicleMessages.NotFound"
                ActionText="Back to my vehicles" ActionHref="/vehicles" />
}
else if (loaded && Model is not null)
{
    <PageHeader Title="@($"Edit {storedName}")"
                Trail="@(new[] { new Crumb("Vehicles", "/vehicles"), new Crumb(storedName, $"/vehicles/{VehicleId}"), new Crumb("Edit") })">
        <Actions>
            <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" href="/vehicles/@VehicleId" title="Back to the vehicle details">
                <Icon Name="IconName.ArrowLeft" /> Back to vehicle
            </a>
        </Actions>
    </PageHeader>

    @if (importFailure is not null)
    {
        <ApiFailureAlert Failure="importFailure.Value" ReturnUrl="@($"/vehicles/{VehicleId}/edit")"
                         NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
    }

    <VehicleForm Tabbed="true" ActiveTab="@activeTab" Model="Model" FormName="update-vehicle" SubmitText="Save changes" CancelHref="@($"/vehicles/{VehicleId}")"
                 Lookups="lookups" Errors="errors" Hints="hints" OnSubmit="SubmitAsync">
        <ImportContent>
            <StickerImportPanel Existing="true" Result="importResult" Message="@importMessage" Level="@importLevel" OnImport="ImportAsync" />
        </ImportContent>
        <MediaContent>
            <VehicleGallerySection VehicleId="VehicleId" VehicleName="@storedName" Images="images" Status="@ImageStatus"
                                   ReturnPath="@EditPath("media")" />
        </MediaContent>
        <DescriptionContent>
            <div class="row g-4">
                <div class="col-lg-6">
                    <VehicleTagsSection VehicleId="VehicleId" Tags="tags" ReturnPath="@EditPath("description")" />
                </div>
                <div class="col-lg-6">
                    <VehicleJournalSection VehicleId="VehicleId" NotesPage="journalPage" ReturnPath="@EditPath("description")" />
                </div>
            </div>
        </DescriptionContent>
    </VehicleForm>
}

@code {
    private IReadOnlyDictionary<string, string[]> errors = new Dictionary<string, string[]>();
    private GarageApiFailure? failure;
    // The saved name, not any unsaved value posted with the form.
    private string storedName = string.Empty;
    private IReadOnlyList<VehicleImageDto> images = [];
    private IReadOnlyList<VehicleTagDto> tags = [];
    private VehicleFormLookups lookups = VehicleFormLookups.Empty;
    private bool notFound;
    // A posted Model exists before the stored vehicle loads, so Model alone can't gate the form.
    private bool loaded;
    // Details unless another tab was asked for; an import or a rejected save also moves it to the details.
    private string? activeTab;
    // A sign-in rejection or outage while importing shows above the form instead of replacing it.
    private GarageApiFailure? importFailure;
    private StickerImportResultDto? importResult;
    private string? importMessage;
    private string importLevel = "danger";
    private StickerHints hints = StickerHints.None;

    [Parameter]
    public Guid VehicleId { get; set; }

    // Which tab to open: details, media, or description.
    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    // Result of the last picture upload, passed back by the upload endpoint.
    [Parameter, SupplyParameterFromQuery(Name = "imageStatus")]
    public string? ImageStatus { get; set; }

    // Read as text: a bad query value must mean the first page of notes, not a binding error.
    [Parameter, SupplyParameterFromQuery(Name = "notesPage")]
    public string? NotesPage { get; set; }

    private int journalPage => int.TryParse(NotesPage, out var parsed) ? Math.Max(1, parsed) : 1;

    private string EditPath(string tab) => $"/vehicles/{VehicleId}/edit?tab={tab}";

    [SupplyParameterFromForm(FormName = "update-vehicle")]
    private VehicleFormModel? Model { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The stored vehicle is loaded on every request; a posted form takes precedence over it.
    protected override async Task OnInitializedAsync()
    {
        activeTab = Tab;
        try
        {
            var result = await Api.GetAsync(VehicleId);
            if (result.IsNotFound)
            {
                MarkNotFound();
                return;
            }

            Model ??= VehicleFormModel.From(result.Value!);
            if (HttpContext is { Request.HasFormContentType: true } http)
            {
                Model.StickerFeatures = StickerFeatureChoice.ReadFrom(http.Request.Form);
            }

            storedName = result.Value!.Name;
            images = result.Value.Images;
            tags = result.Value.Tags;
            lookups = VehicleFormLookups.From((await LookupsApi.GetAsync(includeHidden: false)).Value!, result.Value);
            loaded = true;
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private async Task ImportAsync()
    {
        failure = null;
        importFailure = null;
        try
        {
            var attempt = await StickerImportHandler.RunAsync(HttpContext, StickerApi, VehicleId, HttpContext?.RequestAborted ?? default);
            if (attempt.Failure == StickerImportFailure.NotFound)
            {
                MarkNotFound();
                return;
            }

            activeTab = VehicleTabs.Import;
            importMessage = attempt.Message;
            importLevel = attempt.Level;
            importResult = attempt.Result;
            if (attempt.Result is { Outcome: not StickerImportOutcome.NoDetailsFound } result)
            {
                Model!.ApplyImport(result);
                hints = StickerHints.From(result);
                activeTab = "details";
            }
        }
        catch (GarageApiException ex)
        {
            importFailure = ex.Failure;
            activeTab = VehicleTabs.Import;
        }
    }

    private async Task SubmitAsync()
    {
        failure = null;
        try
        {
            var result = await Api.UpdateAsync(VehicleId, Model!.ToRequest());
            if (result.IsSuccess)
            {
                Navigation.NavigateTo($"/vehicles/{VehicleId}");
                return;
            }

            if (result.IsNotFound)
            {
                MarkNotFound();
                return;
            }

            errors = result.Errors;
            activeTab = "details";
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private void MarkNotFound()
    {
        notFound = true;
        if (HttpContext is { Response.HasStarted: false })
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
