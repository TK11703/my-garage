@inject VehiclesApiClient Api
@inject NavigationManager Navigation

<section aria-labelledby="tags-heading">
    <h2 id="tags-heading" class="h5">Features</h2>

    <EditForm EditContext="editContext" FormName="add-tag" OnValidSubmit="AddAsync" data-testid="add-tag" class="row g-2 align-items-end">
        <div class="col">
            <label for="tag-name" class="form-label fw-semibold">Add a feature</label>
            <InputText id="tag-name" class="form-control" @bind-Value="Model!.Name" maxlength="30" autocomplete="off"
                       list="feature-options" data-suggest-url="/features/suggest"
                       aria-describedby="@(error is null ? "tag-help" : "tag-help tag-error")" />
            <datalist id="feature-options"></datalist>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Add feature</button>
        </div>
    </EditForm>
    <div id="tag-help" class="form-text">Pick a feature other vehicles use, or type a new one. New features are shared with everyone.</div>

    @if (error is not null)
    {
        <div id="tag-error" class="invalid-feedback d-block" role="alert">@error</div>
    }

    <h3 id="included-features-heading" class="h6 fw-semibold mt-4">Included Features</h3>

    @if (Tags.Count == 0)
    {
        <EmptyState Compact="true" Message="No features yet. Start typing to reuse a feature from other vehicles, or add your own." />
    }
    else
    {
        <ul class="list-group" aria-labelledby="included-features-heading" data-testid="feature-list">
            @foreach (var tag in Tags)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center gap-2" @key="tag.Id" data-testid="tag">
                    <span class="text-break">@tag.Name</span>
                    <form method="post" @formname="@($"remove-tag-{tag.Id}")" @onsubmit="() => RemoveAsync(tag.Id)">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-close" aria-label="Remove feature @tag.Name"></button>
                    </form>
                </li>
            }
        </ul>
    }
</section>

@code {
    private string? error;
    private EditContext editContext = default!;
    private ValidationMessageStore messages = default!;

    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<VehicleTagDto> Tags { get; set; } = [];

    // Where to go after a change; defaults to the vehicle page.
    [Parameter]
    public string? ReturnPath { get; set; }

    private string Back => ReturnPath ?? $"/vehicles/{VehicleId}";

    [SupplyParameterFromForm(FormName = "add-tag")]
    private AddTagModel? Model { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new AddTagModel();
        editContext = new EditContext(Model);
        messages = new ValidationMessageStore(editContext);
        editContext.OnValidationRequested += (_, _) => messages.Clear();
    }

    // Shows the message under the field and marks the input invalid for assistive technology.
    private void Fail(string message)
    {
        error = message;
        messages.Add(editContext.Field(nameof(AddTagModel.Name)), message);
        editContext.NotifyValidationStateChanged();
    }

    private async Task AddAsync()
    {
        error = null;
        try
        {
            var result = await Api.AddTagAsync(VehicleId, Model!.Name);
            switch (result.Outcome)
            {
                case ApiOutcome.Success:
                    Navigation.NavigateTo(Back);
                    break;
                case ApiOutcome.Conflict:
                    Fail(result.Title ?? "The feature could not be added.");
                    break;
                case ApiOutcome.Invalid:
                    Fail(result.Errors.Values.SelectMany(messages => messages).FirstOrDefault() ?? "The feature is not valid.");
                    break;
                default:
                    Fail(VehicleMessages.NotFound);
                    break;
            }
        }
        catch (GarageApiException ex)
        {
            Fail(Describe(ex));
        }
    }

    private async Task RemoveAsync(Guid tagId)
    {
        error = null;
        try
        {
            await Api.RemoveTagAsync(VehicleId, tagId);
            Navigation.NavigateTo(Back);
        }
        catch (GarageApiException ex)
        {
            error = Describe(ex);
        }
    }

    private static string Describe(GarageApiException ex) =>
        ex.Failure == GarageApiFailure.NotAccepted ? VehicleMessages.NotAccepted : VehicleMessages.Unavailable;

    public sealed class AddTagModel
    {
        public string? Name { get; set; }
    }
}
