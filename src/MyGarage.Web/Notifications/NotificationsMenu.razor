@implements IDisposable
@inject NotificationsApiClient Api
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject ILogger<NotificationsMenu> Logger

@* The bell: a badge with the unread count, the latest notifications, and a way to the drafts.
   The page loads it once; while the circuit is interactive it also refreshes itself every minute. *@
<div class="dropdown" data-testid="notifications-menu">
    <button type="button" class="btn mg-nav-btn position-relative" aria-label="@ToggleLabel" title="@ToggleLabel"
            data-bs-toggle="dropdown" aria-expanded="false">
        @* Keyed on the count so a new unread item restarts the short shake. *@
        <span @key="unread" class="mg-bell d-inline-flex @(unread > 0 ? "mg-bell-ring" : null)" data-testid="notification-bell">
            <Icon Name="IconName.Bell" Size="20" />
        </span>
        @if (unread > 0)
        {
            <span class="mg-nav-dot" data-testid="notification-badge" aria-hidden="true"></span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end p-0 mg-menu mg-notif-menu">
        <div class="mg-notif-head">
            <span class="fw-semibold">Notifications</span>
            @if (unread > 0)
            {
                <span class="badge rounded-pill mg-notif-count" data-testid="notification-count">@unread new</span>
            }
        </div>

        @if (failed)
        {
            <p class="mb-0 p-3 text-body-secondary">Notifications are not available right now.</p>
        }
        else if (items.Count == 0)
        {
            <p class="mb-0 p-3 text-body-secondary">You have no notifications.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0 mg-notif-list">
                @foreach (var item in items)
                {
                    RenderFragment row = @<text>
                        <span class="mg-notif-icon" aria-hidden="true"><Icon Name="@(item.DraftId is null ? IconName.Bell : IconName.FileText)" Size="18" /></span>
                        <span class="mg-notif-body">
                            <span class="d-block @(item.IsRead ? null : "fw-semibold")">
                                @if (!item.IsRead)
                                {
                                    <span class="visually-hidden">Unread: </span>
                                }
                                @item.Title
                            </span>
                            <span class="d-block small text-body-secondary">@NotificationFormat.Relative(item.CreatedAt, Time.GetUtcNow())</span>
                        </span>
                        @if (!item.IsRead)
                        {
                            <span class="mg-notif-unread" aria-hidden="true"></span>
                        }
                    </text>;

                    <li @key="item.Id" class="mg-notif-item" data-testid="notification">
                        @if (item.DraftId is { } draftId)
                        {
                            <a class="mg-notif-link text-decoration-none text-reset" href="/drafts/@draftId">@row</a>
                        }
                        else
                        {
                            <div class="mg-notif-link">@row</div>
                        }
                        <form method="post" class="mg-notif-dismiss" @formname="@($"dismiss-notification-{item.Id}")" @onsubmit="() => DismissAsync(item.Id)" data-testid="dismiss-notification">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm mg-notif-dismiss-btn" title="Dismiss notification" aria-label="Dismiss notification: @item.Title">
                                <Icon Name="IconName.XLg" Size="12" />
                            </button>
                        </form>
                    </li>
                }
            </ul>
        }

        @if (unread > 0 || items.Any(item => item.IsRead))
        {
            <div class="mg-notif-foot">
                @if (unread > 0)
                {
                    <form method="post" @formname="mark-all-read" @onsubmit="MarkAllReadAsync" data-testid="mark-all-read">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-link btn-sm p-0">Mark all as read</button>
                    </form>
                }
                @if (items.Any(item => item.IsRead))
                {
                    <form method="post" class="ms-auto" @formname="clear-read-notifications" @onsubmit="ClearReadAsync" data-testid="clear-read">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-link btn-sm p-0" title="Remove all read notifications">Clear read</button>
                    </form>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly TimeSpan RefreshEvery = TimeSpan.FromSeconds(60);
    private const int Latest = 20;

    private ITimer? timer;
    private int unread;
    private IReadOnlyList<NotificationDto> items = [];
    private bool failed;
    private bool refreshing;
    private bool disposed;

    // Reports the unread and awaiting-review counts each time they are loaded, so the account menu can show them.
    [Parameter]
    public EventCallback<UnreadCountDto> OnCountLoaded { get; set; }

    private string ToggleLabel => unread > 0 ? $"Notifications, {unread} unread" : "Notifications";

    protected override Task OnInitializedAsync() => LoadAsync();

    // Not called for a statically rendered page, so only an interactive bell keeps a timer.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            timer = Time.CreateTimer(_ => _ = InvokeAsync(RefreshAsync), null, RefreshEvery, RefreshEvery);
        }
    }

    // A failure leaves the bell usable with no badge; it is never worth interrupting the page for.
    private async Task LoadAsync()
    {
        try
        {
            var count = (await Api.GetUnreadCountAsync()).Value;
            var latest = (await Api.ListAsync(Latest)).Value;
            unread = count?.Unread ?? 0;
            items = latest is null ? [] : [.. latest.Take(Latest)];
            failed = false;

            if (count is not null)
            {
                await OnCountLoaded.InvokeAsync(count);
            }
        }
        catch (GarageApiException)
        {
            unread = 0;
            items = [];
            failed = true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Token problems and timeouts are not API answers, but they must not take the page down either.
            Logger.LogWarning(ex, "Notifications could not be loaded.");
            unread = 0;
            items = [];
            failed = true;
        }
    }

    private async Task RefreshAsync()
    {
        if (disposed || refreshing)
        {
            return;
        }

        refreshing = true;
        try
        {
            await LoadAsync();
            StateHasChanged();
        }
        finally
        {
            refreshing = false;
        }
    }

    private async Task MarkAllReadAsync() => await ChangeAsync(() => Api.MarkAllReadAsync());

    private async Task DismissAsync(Guid notificationId) => await ChangeAsync(() => Api.DeleteAsync(notificationId));

    private async Task ClearReadAsync() => await ChangeAsync(() => Api.DeleteReadAsync());

    private async Task ChangeAsync(Func<Task> change)
    {
        try
        {
            await change();
        }
        catch (GarageApiException)
        {
            // The list below says what is still there.
        }

        await LoadAsync();
        Navigation.NavigateTo(Navigation.Uri);
    }

    public void Dispose()
    {
        disposed = true;
        timer?.Dispose();
    }
}
