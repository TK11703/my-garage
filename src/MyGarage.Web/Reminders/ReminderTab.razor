@inject RemindersApiClient Api

<div class="vstack gap-3" data-testid="reminders-view">
    @if (SavedNotice is not null)
    {
        <div class="alert alert-success mb-0" role="status" data-testid="reminder-saved">@SavedNotice</div>
    }

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <p class="text-body-secondary mb-0">Recurring items for this vehicle, by miles, by time, or both.</p>
        <a class="btn btn-primary d-inline-flex align-items-center gap-2" href="@ReminderLinks.New(VehicleId)" data-testid="add-reminder">
            <Icon Name="IconName.Plus" /> Add reminder
        </a>
    </div>

    @if (failure is not null)
    {
        <ApiFailureAlert Failure="failure.Value" ReturnUrl="@($"/vehicles/{VehicleId}?tab=reminders")"
                         NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
    }
    else if (reminders is null)
    {
        <p class="text-body-secondary mb-0">Loading reminders...</p>
    }
    else if (reminders.Count == 0)
    {
        <EmptyState Variant="EmptyStateVariant.Empty"
                    Message="No reminders yet. Add one for things like oil changes, inspections, and registrations."
                    ActionText="Add reminder" ActionHref="@ReminderLinks.New(VehicleId)" />
    }
    else
    {
        <ul class="list-group" data-testid="reminder-list">
            @foreach (var reminder in reminders)
            {
                <li class="list-group-item" data-testid="reminder">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <div>
                            <a class="fw-semibold" href="@ReminderLinks.Detail(VehicleId, reminder.Id)" data-testid="reminder-link">@reminder.Name</a>
                            <div class="small text-body-secondary">@ReminderFormat.AppliesTo(reminder) &middot; @ReminderFormat.Interval(reminder)</div>
                        </div>
                        <div class="small text-md-end">
                            <div>Last done: @ReminderFormat.LastDone(reminder)</div>
                            <div>Next due: @ReminderFormat.NextDue(reminder)</div>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    private IReadOnlyList<ReminderDto>? reminders;
    private GarageApiFailure? failure;

    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    // The query value set after a save, for the notice at the top.
    [Parameter]
    public string? Saved { get; set; }

    private string? SavedNotice => ReminderMessages.Saved(Saved);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.ListAsync(VehicleId);
            reminders = result.Value ?? [];
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }
}
