@page "/dashboard"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject DashboardApiClient Api

<PageHeader Title="Dashboard" />

@if (failure is not null)
{
    <ApiFailureAlert Failure="failure.Value" ReturnUrl="/dashboard"
                     NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
}
else if (dashboard is null)
{
    <p class="text-body-secondary">Loading your garage...</p>
}
else
{
    @if (dashboard.Vehicles == 0)
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2" role="status" data-testid="first-vehicle">
            <span>Your garage is empty. Add a vehicle to start keeping its records, reminders, and costs.</span>
            <a class="btn btn-primary d-inline-flex align-items-center gap-2" href="/vehicles/new"><Icon Name="IconName.Plus" /> Add your first vehicle</a>
        </div>
    }

    <ul class="list-unstyled row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 mb-4" aria-label="Garage figures">
        <Metric Id="vehicles" Label="Vehicles" Value="dashboard.Vehicles" Href="/vehicles" />
        <Metric Id="service-records" Label="Service records" Value="dashboard.ServiceRecords" />
        <Metric Id="fuel-energy-entries" Label="Fuel and charging entries" Value="dashboard.FuelEnergyEntries" />
        <Metric Id="drafts" Label="Drafts awaiting review" Value="dashboard.DraftsAwaitingReview" Href="/drafts" />
        <Metric Id="overdue" Label="Reminders overdue" Value="dashboard.RemindersOverdue" Href="/reminders?status=overdue" Tone="danger" />
        <Metric Id="due-soon" Label="Reminders due soon" Value="dashboard.RemindersDueSoon" Href="/reminders?status=due-soon" Tone="warning" />
    </ul>

    @if (dashboard.Vehicles > 0)
    {
        <section aria-labelledby="attention-heading" data-testid="attention">
            <h2 id="attention-heading" class="h5">Needs attention</h2>
            @if (dashboard.Attention.Count == 0)
            {
                <p class="text-body-secondary">Nothing needs attention right now.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var reminder in dashboard.Attention)
                    {
                        <ReminderRow Reminder="reminder" ShowVehicle="true" />
                    }
                </ul>
            }
        </section>
    }
}

@code {
    private DashboardDto? dashboard;
    private GarageApiFailure? failure;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            dashboard = (await Api.GetAsync()).Value;
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }
}
