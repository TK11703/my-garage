@page "/faq"
@attribute [AllowAnonymous]

<PageHeader Title="Frequently Asked Questions" Trail="@(new[] { new Crumb("FAQ") })" />

<div class="row">
    <div class="col-lg-8">
        <div class="accordion" id="faq-accordion">
            @foreach (var (id, question, answer) in Items)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#faq-@id" aria-expanded="false" aria-controls="faq-@id">
                            @question
                        </button>
                    </h2>
                    <div id="faq-@id" class="accordion-collapse collapse" data-bs-parent="#faq-accordion">
                        <div class="accordion-body">@answer</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private static readonly (string Id, string Question, string Answer)[] Items =
    [
        ("add", "How do I add a vehicle?", "Open My Vehicles and choose Add vehicle. Enter the year, make, and model; the other details are optional. The vehicle is named from its year, make, and model."),
        ("edit", "How do I change or delete a vehicle?", "Open the vehicle and choose Edit to update its details. To remove it, use Delete vehicle at the bottom of the page and confirm; this also removes its tags, notes, service records, charging and fueling entries, inspections, registrations, insurance, taxes, and pictures."),
        ("tags", "What are tags?", "Tags are short free-text words that describe a vehicle's features, such as \"tow package\" or \"sunroof\". You can search and filter by tag."),
        ("journal", "What is the journal?", "Each vehicle has a journal of notes. Give a note an optional category of your own choosing, such as \"Maintenance\" or \"Trips\"."),
        ("service", "How do I keep track of services?", "Open the vehicle and choose its Maintenance tab and open Service Records. Choose the + button in its header and Add service record, then enter the date, the odometer reading, and the shop or person, then add a line item for each service performed, priced as a flat cost or as labor hours and parts. The record shows the total cost, and the latest odometer reading updates the mileage on the vehicle's card."),
        ("fuel", "How do I record fuel and charging?", "Open the vehicle, choose its Maintenance tab, and open Charging and Fueling. Choose the + button in its header, then Add fuel to enter the price per gallon, the total gallons, and the total, or Add charge to enter the price per kWh, the kWh delivered, and the total session cost. If you leave the total empty it is calculated from the price and the amount."),
        ("records", "How do I record inspections, registrations, insurance, and taxes?", "Open the vehicle, choose its Maintenance tab, and open Inspections, Registrations, Insurance, and Taxes. Each has its own list; choose the + button in the header and then the kind to add: an inspection has a type, date, cost, and an optional next due date; a registration has a state, cost, and expiration date; insurance has a start date, an end date, how often the premium is paid, and the cost of each payment; a tax has a type, an amount, and how often it recurs. Use Edit on any row to correct or delete it."),
        ("pictures", "How many pictures can I add?", "Each vehicle holds up to 10 pictures of up to 5 MB each. Choose one as the main picture to show on its card."),
        ("search", "How do I find a vehicle?", "Use the search box at the top of any page, or the search and filters on My Vehicles to narrow by make, color, doors, tag, or mileage."),
        ("privacy", "Who can see my vehicles?", "Only you. Your vehicles, notes, and pictures are private to your account."),
    ];
}
