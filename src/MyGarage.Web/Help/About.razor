@page "/about"
@attribute [AllowAnonymous]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageHeader Title="About My Garage" Trail="@(new[] { new Crumb("About") })" />

<section class="mg-about-hero" aria-label="Introduction">
    <div>
        <p class="mg-about-lead">My Garage keeps a private list of the vehicles you own.</p>
        <p class="mg-about-copy">
            For each vehicle you can record details such as make, model, trim, color, mileage, and doors, add tags that
            describe its features, keep a journal of notes, build a small gallery of pictures, and keep a service history
            with the work done and what it cost. Fuel and charging, inspections, registrations, insurance, and taxes
            each have a place too, so the whole story of a vehicle is in one spot when you need it.
        </p>
        <div class="d-flex flex-wrap gap-2">
            @if (signedIn)
            {
                <a class="btn btn-primary" href="/vehicles">My vehicles</a>
                <a class="btn btn-outline-secondary" href="/faq">Read the FAQ</a>
            }
            else
            {
                <a class="btn btn-primary" href="/authentication/login">Sign in</a>
                <a class="btn btn-outline-secondary" href="/faq">Read the FAQ</a>
            }
        </div>
    </div>
    <dl class="mg-plate" data-testid="about-facts">
        <div><dt>Who can see your vehicles</dt><dd>Only you</dd></div>
        <div><dt>Works on</dt><dd>Phone &middot; tablet &middot; desktop</dd></div>
        <div><dt>Look</dt><dd>Light or dark</dd></div>
        <div><dt>Sign-in</dt><dd>Microsoft account</dd></div>
    </dl>
</section>

<section class="mg-about-section" aria-labelledby="about-how-heading">
    <h2 id="about-how-heading" class="mg-rule-title">How it works</h2>
    <ol class="list-unstyled mg-about-steps">
        @for (var i = 0; i < Steps.Length; i++)
        {
            var step = Steps[i];
            <li class="card mg-about-step" data-testid="about-step">
                <span class="mg-about-step-n" aria-hidden="true">@((i + 1).ToString("00"))</span>
                <h3>@step.Title</h3>
                <p>@step.Description</p>
            </li>
        }
    </ol>
</section>

<section class="mg-about-section" aria-labelledby="about-features-heading">
    <h2 id="about-features-heading" class="mg-rule-title">What you can do</h2>
    <ul class="list-unstyled mg-about-features">
        @foreach (var feature in Features)
        {
            <li data-testid="about-feature">
                <h3>@feature.Title</h3>
                <p>@feature.Description</p>
            </li>
        }
    </ul>
</section>

<section class="mg-about-section" aria-labelledby="about-privacy-heading">
    <h2 id="about-privacy-heading" class="mg-rule-title">Privacy</h2>
    <div class="card mg-about-privacy">
        <span class="mg-status-led mg-about-led" aria-hidden="true"></span>
        <div>
            <h3>Your vehicles are visible only to you</h3>
            <p>
                Every vehicle, note, picture, and record belongs to your account, and no one else can see or change them.
                You sign in with your Microsoft account, so there is no extra password to remember.
            </p>
            <p>
                When you add a record from a file or an email, the file is read only to prepare a draft for you. Nothing becomes
                part of your garage until you review it and include it, and what you upload is never written to the application's logs.
            </p>
        </div>
    </div>
</section>
@code {
    private sealed record Feature(string Title, string Description);

    private sealed record Step(string Title, string Description);

    private static readonly Feature[] Features =
    [
        new("Every vehicle in one list", "Year, make, model, VIN, specifications, mileage, and a main picture on each garage card."),
        new("Pictures", "Upload photos, choose a main picture, and add captions."),
        new("Journal and features", "Dated notes about trips and repairs, and tags for the features each vehicle has."),
        new("Service history", "Service records with line items, labor, and parts, and the total cost of each visit."),
        new("Fuel, charging, and compliance", "Fuel and charging entries, inspections, registrations, insurance, and taxes with their due dates."),
        new("Records from email and files", "Forward an invoice or upload a file and review the draft before anything is saved."),
        new("Reminders", "Oil changes, inspections, registrations, and anything else that repeats by miles or by time, with a notice when one is due."),
        new("Dashboard", "Your vehicles, records, drafts, and due reminders at a glance."),
        new("Window sticker import", "Fill in a new vehicle from a photo or PDF of its window sticker."),
        new("Make it yours", "Choose the vehicle types, fuel types, transmissions, and drivetrains you see in your forms."),
        new("Light and dark", "Switch the look with one button; your choice stays in your browser."),
    ];

    private static readonly Step[] Steps =
    [
        new("Add your vehicles", "Enter a vehicle by hand or start from its window sticker, then add pictures and notes."),
        new("Keep the records", "Add services, fuel and charging, and compliance entries as they happen, or let a forwarded invoice become a draft."),
        new("Find it when you need it", "Search from the top bar and open any vehicle to see its details, history, and documents."),
    ];

    private bool signedIn;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        signedIn = state.User.Identity?.IsAuthenticated ?? false;
    }
}
