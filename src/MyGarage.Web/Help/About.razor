@page "/about"
@attribute [AllowAnonymous]

<PageHeader Title="About My Garage" Trail="@(new[] { new Crumb("About") })" />

<div class="row">
    <div class="col-lg-8">
        <p class="lead">My Garage keeps a private list of the vehicles you own.</p>
        <p>
            For each vehicle you can record details such as make, model, trim, color, mileage, and doors, add tags that
            describe its features, keep a journal of notes, build a small gallery of pictures, and keep a service history
            with the work done and what it cost.
        </p>
        <p>Your vehicles are visible only to you.</p>
    </div>
</div>
