@inject AuthenticationStateProvider AuthenticationStateProvider

<header>
    <nav class="navbar navbar-dark fixed-top mg-navbar" aria-label="Main">
        <div class="container-fluid gap-2">
            <div class="d-flex align-items-center gap-1 mg-navbar-start">
                @if (isSignedIn)
                {
                    <button type="button" class="btn mg-nav-btn d-md-none" aria-label="Open menu"
                            aria-controls="mg-sidebar" aria-expanded="false" data-mg-sidebar-toggle>
                        <Icon Name="IconName.List" Size="24" />
                    </button>
                }

                <BrandLink />
            </div>

            @if (isSignedIn)
            {
                <div class="collapse d-md-block mg-search" id="navbar-search">
                    <form method="get" action="/search" role="search">
                        <div class="mg-search-field">
                            <button type="submit" class="mg-search-submit" aria-label="Search">
                                <Icon Name="IconName.Search" Size="18" />
                            </button>
                            <input type="search" name="q" class="form-control" maxlength="100"
                                   placeholder="Search vehicles" aria-label="Search vehicles" />
                        </div>
                    </form>
                </div>
            }

            <div class="d-flex align-items-center gap-1 ms-auto">
                @if (isSignedIn)
                {
                    <button type="button" class="btn mg-nav-btn d-md-none" aria-label="Toggle search"
                            data-bs-toggle="collapse" data-bs-target="#navbar-search"
                            aria-controls="navbar-search" aria-expanded="false">
                        <Icon Name="IconName.Search" Size="20" />
                    </button>

                    <NotificationsMenu OnCountLoaded="OnCountLoaded" />
                }
                else
                {
                    <div class="dropdown">
                        <button type="button" class="btn mg-nav-btn" aria-label="Help"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <Icon Name="IconName.QuestionCircle" Size="20" />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end mg-menu">
                            <li><a class="dropdown-item" href="/faq">FAQ</a></li>
                            <li><a class="dropdown-item" href="/about">About</a></li>
                        </ul>
                    </div>
                }

                <ThemeToggle />

                @if (!isSignedIn)
                {
                    <a class="btn btn-outline-light btn-sm ms-1" href="/authentication/login">Sign in</a>
                }
            </div>
        </div>
    </nav>
</header>

@code {
    private bool isSignedIn;

    // Reports the unread and awaiting-review counts the bell loads, so the layout can show the drafts count in the menu.
    [Parameter]
    public EventCallback<UnreadCountDto> OnCountLoaded { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isSignedIn = state.User.Identity?.IsAuthenticated ?? false;
    }
}
