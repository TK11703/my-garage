<PageTitle>@Title – My Garage</PageTitle>

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb mb-1">
        @if (Trail.Count == 0)
        {
            <li class="breadcrumb-item active" aria-current="page"><span class="mg-crumb text-truncate d-inline-block">Home</span></li>
        }
        else
        {
            <li class="breadcrumb-item"><span class="mg-crumb text-truncate d-inline-block"><a href="/">Home</a></span></li>
            @for (var i = 0; i < Trail.Count; i++)
            {
                var crumb = Trail[i];
                if (i == Trail.Count - 1)
                {
                    <li class="breadcrumb-item active" aria-current="page"><span class="mg-crumb text-truncate d-inline-block">@crumb.Label</span></li>
                }
                else if (crumb.Href is not null)
                {
                    <li class="breadcrumb-item"><span class="mg-crumb text-truncate d-inline-block"><a href="@crumb.Href">@crumb.Label</a></span></li>
                }
                else
                {
                    <li class="breadcrumb-item"><span class="mg-crumb text-truncate d-inline-block">@crumb.Label</span></li>
                }
            }
        }
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@Title</h1>
    @Actions
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    // Crumbs after the implicit "Home"; the last one is the current page and is never a link.
    [Parameter]
    public IReadOnlyList<Crumb> Trail { get; set; } = [];

    [Parameter]
    public RenderFragment? Actions { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Title))
        {
            throw new ArgumentException("A page header needs a title.", nameof(Title));
        }
    }
}
