@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

<a class="visually-hidden-focusable mg-skip-link" href="#main-content">Skip to main content</a>

@if (isSignedIn)
{
    <AppRail />
}
else
{
    <PublicBar />
}

<main id="main-content" class="mg-content @(isSignedIn ? "mg-content-with-rail" : "mg-content-public")" tabindex="-1">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href=".">Reload</a>
    <span class="dismiss">&#128473;</span>
</div>

@code {
    private bool isSignedIn;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isSignedIn = state.User.Identity?.IsAuthenticated ?? false;
    }
}
