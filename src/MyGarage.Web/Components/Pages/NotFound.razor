@page "/not-found"
@layout MainLayout

<PageHeader Title="404 Error" Trail="@(new[] { new Crumb("Not found") })" />

<section class="card border-0 shadow-sm" aria-labelledby="not-found-heading">
    <div class="card-body mg-notfound" data-testid="not-found">
        <div class="mg-notfound-body">
            <div class="mg-notfound-code mg-odometer" role="img" aria-label="404" data-testid="odometer">
                @foreach (var digit in new[] { 4, 0, 4 })
                {
                    <span class="mg-odo-wheel mg-odo-d@(digit)" aria-hidden="true">
                        <span class="mg-odo-strip">
                            @for (var i = 0; i < 10; i++)
                            {
                                <span>@i</span>
                            }
                        </span>
                    </span>
                }
            </div>
            <h2 id="not-found-heading" class="mg-notfound-label">Page not found<small>MILES FROM HOME: 404</small></h2>
            <p class="text-body-secondary mg-notfound-copy">
                It's looking like you may have taken a wrong turn. Don't worry... it happens to the best of us.
                Here's a little tip that might help you get back on track.
            </p>
            <div class="mg-notfound-actions">
                <a class="btn btn-primary d-inline-flex align-items-center gap-2" href="/" data-testid="return-home">
                    <Icon Name="IconName.ArrowLeft" /> Return Home
                </a>
                <a class="btn btn-outline-secondary" href="/faq">Read the FAQ</a>
            </div>
            <form class="mg-notfound-find" method="get" action="/search" role="search" data-testid="search-instead">
                <span aria-hidden="true"><Icon Name="IconName.Search" /></span>
                <input type="search" name="q" class="form-control" placeholder="Or search your vehicles" aria-label="Search your vehicles" />
            </form>
        </div>
    </div>
</section>
