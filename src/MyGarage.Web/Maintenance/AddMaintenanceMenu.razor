@* One "Add" dropdown for the page bar. It holds every add action that used to sit on the accordion headers. *@
<div class="dropdown" data-testid="add-maintenance-menu">
    <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" title="Add a service record, fuel, charge, compliance entry, or reminder"
            data-bs-toggle="dropdown" aria-expanded="false">
        <Icon Name="IconName.Plus" /> Add <Icon Name="IconName.ChevronDown" Size="12" />
    </button>
    <ul class="dropdown-menu dropdown-menu-end mg-menu">
        <li><h6 class="dropdown-header">Service</h6></li>
        <li><a class="dropdown-item" href="/vehicles/@VehicleId/service-records/new" data-testid="add-service-record">Add service record</a></li>
        <li><hr class="dropdown-divider" /></li>
        <li><h6 class="dropdown-header">Charging and fueling</h6></li>
        <li><a class="dropdown-item" href="/vehicles/@VehicleId/fuel-energy-entries/new?kind=fuel" data-testid="add-fuel">Add fuel</a></li>
        <li><a class="dropdown-item" href="/vehicles/@VehicleId/fuel-energy-entries/new?kind=energy" data-testid="add-charge">Add charge</a></li>
        <li><hr class="dropdown-divider" /></li>
        <li><h6 class="dropdown-header">Compliance</h6></li>
        <li><a class="dropdown-item" href="/vehicles/@VehicleId/inspections/new" data-testid="add-inspection">Add inspection</a></li>
        <li><a class="dropdown-item" href="/vehicles/@VehicleId/registrations/new" data-testid="add-registration">Add registration</a></li>
        <li><a class="dropdown-item" href="/vehicles/@VehicleId/insurance/new" data-testid="add-insurance">Add insurance</a></li>
        <li><a class="dropdown-item" href="/vehicles/@VehicleId/taxes/new" data-testid="add-tax">Add tax</a></li>
        <li><hr class="dropdown-divider" /></li>
        <li><h6 class="dropdown-header">Reminders</h6></li>
        <li><a class="dropdown-item" href="@ReminderLinks.New(VehicleId)" data-testid="add-reminder">Add reminder</a></li>
    </ul>
</div>

@code {
    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }
}
