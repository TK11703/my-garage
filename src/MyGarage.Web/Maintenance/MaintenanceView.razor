@* No data-bs-parent on the items, so each one opens and closes on its own. *@
@if (ArchivedState?.IsArchived != true)
{
    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2" href="/drafts/upload?vehicleId=@VehicleId"
           data-testid="import-record" aria-label="Import a record for this vehicle">
            <Icon Name="IconName.CloudUpload" Size="16" /> Import Record
        </a>
    </div>
}

<div class="accordion vstack gap-3" id="maintenance-accordion" data-testid="maintenance-accordion">
    <ServiceRecordsSection VehicleId="VehicleId" Page="RecordsPage" Expanded="@(Section == MaintenanceSection.Records)" />

    <FuelSection VehicleId="VehicleId" Page="FuelPage" Expanded="@(Section == MaintenanceSection.Fuel)" />

    <ComplianceSection VehicleId="VehicleId" Expanded="@(Section == MaintenanceSection.Compliance)" InspectionsPage="InspectionsPage"
                       RegistrationsPage="RegistrationsPage" InsurancePage="InsurancePage" TaxesPage="TaxesPage" />

    <DocumentsSection VehicleId="VehicleId" Page="DocumentsPage" Expanded="@(Section == MaintenanceSection.Documents)" />
</div>

@code {
    // Set by the vehicle page; an archived vehicle cannot take new records.
    [CascadingParameter]
    private VehicleArchivedState? ArchivedState { get; set; }

    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    // Which accordion item starts open.
    [Parameter]
    public MaintenanceSection Section { get; set; } = MaintenanceSection.Records;

    // Each list pages on its own query value (1-based).
    [Parameter]
    public int RecordsPage { get; set; } = 1;

    [Parameter]
    public int FuelPage { get; set; } = 1;

    [Parameter]
    public int InspectionsPage { get; set; } = 1;

    [Parameter]
    public int RegistrationsPage { get; set; } = 1;

    [Parameter]
    public int InsurancePage { get; set; } = 1;

    [Parameter]
    public int TaxesPage { get; set; } = 1;

    [Parameter]
    public int DocumentsPage { get; set; } = 1;
}
