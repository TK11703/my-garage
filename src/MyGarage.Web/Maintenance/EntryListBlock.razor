@typeparam TItem

@* Shared chrome for the Maintenance lists: add actions, rows or an empty state, a pager, and a failure alert. *@
<div class="d-flex flex-wrap justify-content-end gap-2 mb-3" data-testid="entry-add-actions">
    @AddActions
</div>

@if (Failure is not null)
{
    <ApiFailureAlert Failure="Failure.Value" ReturnUrl="@ReturnUrl"
                     NotAcceptedMessage="@VehicleMessages.NotAccepted" UnavailableMessage="@VehicleMessages.Unavailable" />
}
else if (Items is not null)
{
    @if (TotalCount == 0)
    {
        <EmptyState Compact="true" Message="@EmptyMessage" />
    }
    else
    {
        <ul class="list-group" data-testid="@ListTestId">
            @foreach (var item in Items)
            {
                <li @key="item" class="list-group-item">
                    @RowTemplate(item)
                </li>
            }
        </ul>

        <Pager Page="Page" TotalPages="TotalPages" HrefFor="HrefFor" />
    }
}

@code {
    [Parameter]
    public IReadOnlyList<TItem>? Items { get; set; }

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    // Builds the link for a page so each list keeps its own query value.
    [Parameter]
    public Func<int, string> HrefFor { get; set; } = _ => "#";

    [Parameter, EditorRequired]
    public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    [Parameter, EditorRequired]
    public string EmptyMessage { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? AddActions { get; set; }

    [Parameter]
    public GarageApiFailure? Failure { get; set; }

    // App-relative page to come back to after signing in again.
    [Parameter]
    public string ReturnUrl { get; set; } = "/";

    [Parameter]
    public string ListTestId { get; set; } = "entry-list";
}
