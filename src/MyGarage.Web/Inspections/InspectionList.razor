@* Display only: the parent loads the page of inspections. *@
<EntryListBlock TItem="InspectionDto" Items="Entries?.Items" TotalCount="Entries?.TotalCount ?? 0" Page="Entries?.Page ?? 1" TotalPages="Entries?.TotalPages ?? 1"
                HrefFor="HrefFor" Failure="Failure" ReturnUrl="@ReturnUrl" EmptyMessage="No inspections yet. Add the first inspection for this vehicle." ListTestId="inspection-list">
    <RowTemplate Context="entry">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2" data-testid="inspection">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-semibold" data-testid="entry-date">@DisplayFormat.Date(entry.InspectionDate)</span>
                    <span class="badge @(entry.Type == InspectionType.Safety ? "text-bg-secondary" : "text-bg-success")" data-testid="entry-type">@InspectionFormat.TypeLabel(entry.Type)</span>
                    @if (entry.FromEmail)
                    {
                        <span class="badge text-bg-info fw-normal" data-testid="from-email">From email</span>
                    }
                </div>
                <div class="small text-body-secondary" data-testid="entry-next-due">@InspectionFormat.NextDue(entry.NextDueDate)</div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="fw-semibold" data-testid="entry-cost">@DisplayFormat.Money(entry.Cost)</span>
                <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" href="/vehicles/@VehicleId/inspections/@entry.Id/edit"
                   data-testid="edit-entry" aria-label="@InspectionFormat.EditName(entry)" title="@InspectionFormat.EditName(entry)">
                    <Icon Name="IconName.Pencil" /> Edit
                </a>
            </div>
        </div>
    </RowTemplate>
</EntryListBlock>

@code {
    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    [Parameter]
    public PagedResultDto<InspectionDto>? Entries { get; set; }

    [Parameter]
    public GarageApiFailure? Failure { get; set; }

    // App-relative page to come back to after signing in again.
    [Parameter]
    public string ReturnUrl { get; set; } = "/";

    [Parameter, EditorRequired]
    public Func<int, string> HrefFor { get; set; } = _ => "#";
}
