@page "/vehicles/{VehicleId:guid}/registrations/{EntryId:guid}/edit"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject VehiclesApiClient VehiclesApi
@inject RegistrationsApiClient Api
@inject NavigationManager Navigation

<MaintenancePage Title="Edit registration" VehicleId="VehicleId" VehicleName="@vehicleName" Section="MaintenanceSection.Compliance"
                 Failure="failure" ReturnUrl="@EditHref"
                 NotFound="notFound" NotFoundTitle="Registration not found" NotFoundMessage="This registration could not be found.">
    @if (loaded && Model is not null)
    {
        <RegistrationForm Model="Model" FormName="update-registration" SubmitText="Save changes" SubmitTitle="Save your changes"
                          CancelHref="@MaintenanceLinks.TabHref(VehicleId, MaintenanceSection.Compliance)" Errors="errors" OnSubmit="SubmitAsync">
            <Delete>
                <DeleteEntryPanel Noun="registration" FormName="delete-registration" TestId="delete-registration"
                                  KeepHref="@EditHref" OnDelete="DeleteAsync" />
            </Delete>
        </RegistrationForm>
    }
</MaintenancePage>

@code {
    private IReadOnlyDictionary<string, string[]> errors = new Dictionary<string, string[]>();
    private GarageApiFailure? failure;
    private string? vehicleName;
    private bool notFound;
    // A posted Model exists before the stored registration loads, so Model alone can't gate the form.
    private bool loaded;

    [Parameter]
    public Guid VehicleId { get; set; }

    [Parameter]
    public Guid EntryId { get; set; }

    [SupplyParameterFromForm(FormName = "update-registration")]
    private RegistrationFormModel? Model { get; set; }

    private string EditHref => $"/vehicles/{VehicleId}/registrations/{EntryId}/edit";

    // The stored registration is loaded on every request; a posted form takes precedence over it.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var vehicle = await VehiclesApi.GetAsync(VehicleId);
            var result = vehicle.IsNotFound ? null : await Api.GetAsync(VehicleId, EntryId);
            if (vehicle.IsNotFound || result!.IsNotFound)
            {
                notFound = true;
                return;
            }

            Model ??= RegistrationFormModel.From(result.Value!);
            vehicleName = vehicle.Value!.Name;
            loaded = true;
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private async Task SubmitAsync()
    {
        failure = null;
        try
        {
            var result = await Api.UpdateAsync(VehicleId, EntryId, Model!.ToRequest());
            if (result.IsSuccess)
            {
                Navigation.NavigateTo(MaintenanceLinks.TabHref(VehicleId, MaintenanceSection.Compliance));
                return;
            }

            if (result.IsNotFound)
            {
                notFound = true;
                return;
            }

            errors = result.Errors;
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            var result = await Api.DeleteAsync(VehicleId, EntryId);
            if (result.IsSuccess || result.IsNotFound)
            {
                Navigation.NavigateTo(MaintenanceLinks.TabHref(VehicleId, MaintenanceSection.Compliance));
            }
        }
        catch (GarageApiException ex)
        {
            failure = ex.Failure;
        }
    }
}
